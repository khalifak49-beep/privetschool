@model UserIndexViewModel
@{
    ViewData["Title"] = "المستخدمون";
    var canManage = User.Can(Permissions.UsersManage);
}

<div class="page-head">
    <div>
        <h1>مستخدمو النظام</h1>
        <p class="sub">@Model.TotalUsers مستخدم · @Model.ActiveUsers نشط</p>
    </div>
    @if (canManage)
    {
        <div class="actions">
            <a class="btn btn-primary" asp-action="Create"><i class="bi bi-person-plus me-1"></i> مستخدم جديد</a>
        </div>
    }
</div>

<div class="card mb-3">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label">بحث</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input name="q" value="@Model.Q" class="form-control" placeholder="الاسم، البريد، الجوال..." />
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label">الدور</label>
                <select name="role" class="form-select form-select-sm" data-autosubmit>
                    <option value="">الكل</option>
                    @foreach (var r in Model.Roles)
                    {
                        <option value="@r" selected="@(Model.Role == r)">@RoleNames.Display(r)</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">الحالة</label>
                <select name="isActive" class="form-select form-select-sm" data-autosubmit>
                    <option value="">الكل</option>
                    <option value="true" selected="@(Model.IsActive == true)">نشط</option>
                    <option value="false" selected="@(Model.IsActive == false)">معطّل</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-1">
                <button class="btn btn-sm btn-primary flex-grow-1" aria-label="تطبيق التصفية"><i class="bi bi-funnel"></i></button>
                <a asp-action="Index" class="btn btn-sm btn-light" aria-label="مسح الفلاتر"><i class="bi bi-x-lg"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="table-wrap">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
            <tr>
                <th>المستخدم</th>
                <th>الأدوار</th>
                <th>مرتبط بـ</th>
                <th>آخر دخول</th>
                <th>الحالة</th>
                <th style="width:130px"></th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Users.TotalCount == 0)
            {
                <tr><td colspan="6"><div class="empty-state"><i class="bi bi-person-gear"></i>لا توجد نتائج</div></td></tr>
            }
            @foreach (var u in Model.Users.Items)
            {
                <tr>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <div class="avatar sm">
                                @if (!string.IsNullOrEmpty(u.PhotoPath))
                                {
                                    <img src="@u.PhotoPath" alt="" />
                                }
                                else
                                {
                                    @ViewHelpers.Initials(u.FullName)
                                }
                            </div>
                            <div class="min-w-0">
                                <div class="fw-semibold text-truncate">@u.FullName</div>
                                <div class="fs-xs text-muted-3" dir="ltr">@u.Email</div>
                            </div>
                        </div>
                    </td>
                    <td>
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var r in u.Roles)
                            {
                                <span class="chip @(r == RoleNames.SuperAdmin ? "tone-danger" : "tone-brand")">@RoleNames.Display(r)</span>
                            }
                            @if (u.Roles.Count == 0)
                            {
                                <span class="text-muted-3 fs-sm">بلا دور</span>
                            }
                        </div>
                    </td>
                    <td class="fs-sm text-muted-2">@(u.LinkedTo ?? "—")</td>
                    <td class="num fs-sm text-muted-2">@ViewHelpers.DateTimeShort(u.LastLoginAt)</td>
                    <td>
                        @if (u.IsActive)
                        {
                            <span class="chip tone-ok">نشط</span>
                        }
                        else
                        {
                            <span class="chip tone-danger">معطّل</span>
                        }
                        @if (u.IsLockedOut)
                        {
                            <span class="chip tone-warn"><i class="bi bi-lock"></i>مقفل</span>
                        }
                    </td>
                    <td>
                        @if (canManage)
                        {
                            <div class="d-flex gap-1">
                                <a class="btn btn-sm btn-light" asp-action="Edit" asp-route-id="@u.Id" aria-label="تعديل"><i class="bi bi-pencil"></i></a>
                                <form asp-action="ToggleActive" method="post">
                                    <input type="hidden" name="id" value="@u.Id" />
                                    <button class="btn btn-sm btn-light" title="@(u.IsActive ? "تعطيل" : "تفعيل")"
                                            data-confirm="@(u.IsActive ? "تعطيل هذا الحساب؟" : "تفعيل هذا الحساب؟")">
                                        <i class="bi @(u.IsActive ? "bi-toggle-on text-success" : "bi-toggle-off")"></i>
                                    </button>
                                </form>
                                @if (u.IsLockedOut)
                                {
                                    <form asp-action="Unlock" method="post">
                                        <input type="hidden" name="id" value="@u.Id" />
                                        <button class="btn btn-sm btn-light text-warning" title="إلغاء القفل"><i class="bi bi-unlock"></i></button>
                                    </form>
                                }
                                <form asp-action="Delete" method="post">
                                    <input type="hidden" name="id" value="@u.Id" />
                                    <button class="btn btn-sm btn-light text-danger" data-confirm="حذف هذا المستخدم نهائياً؟" aria-label="حذف"><i class="bi bi-trash"></i></button>
                                </form>
                            </div>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="Model.Users" />
</div>
