@model HomeworkFormViewModel
@{
    ViewData["Title"] = Model.IsEdit ? "تعديل واجب" : "واجب جديد";
}

<div class="page-head">
    <div>
        <nav class="breadcrumb">
            <span class="breadcrumb-item"><a asp-action="Index">الواجبات</a></span>
            <span class="breadcrumb-item active">@ViewData["Title"]</span>
        </nav>
        <h1>@ViewData["Title"]</h1>
    </div>
</div>

<div class="row">
    <div class="col-lg-9">
        <div class="card">
            <form asp-action="@(Model.IsEdit ? "Edit" : "Create")" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="AttachmentPath" />
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger fs-sm"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Title" class="form-label"></label>
                            <input asp-for="Title" class="form-control" placeholder="واجب الوحدة الثالثة" />
                            <span asp-validation-for="Title" class="text-danger fs-xs"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="4"
                                      placeholder="اكتب تفاصيل الواجب والمطلوب من الطالب..."></textarea>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="SectionId" class="form-label"></label>
                            <select asp-for="SectionId" class="form-select" asp-items="Model.Sections" disabled="@Model.IsEdit">
                                <option value="">— اختر الشعبة —</option>
                            </select>
                            @if (Model.IsEdit)
                            {
                                <input type="hidden" asp-for="SectionId" />
                            }
                            <span asp-validation-for="SectionId" class="text-danger fs-xs"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="SubjectId" class="form-label"></label>
                            <select asp-for="SubjectId" class="form-select" asp-items="Model.Subjects">
                                <option value="">— اختر المادة —</option>
                            </select>
                            <span asp-validation-for="SubjectId" class="text-danger fs-xs"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="TermId" class="form-label"></label>
                            <select asp-for="TermId" class="form-select" asp-items="Model.Terms">
                                <option value="">— اختر الفصل —</option>
                            </select>
                        </div>

                        @if (User.Can(Permissions.AcademicManage))
                        {
                            <div class="col-md-4">
                                <label asp-for="TeacherId" class="form-label"></label>
                                <select asp-for="TeacherId" class="form-select" asp-items="Model.Teachers">
                                    <option value="">— اختر المعلم —</option>
                                </select>
                            </div>
                        }
                        else
                        {
                            <input type="hidden" asp-for="TeacherId" />
                        }

                        <div class="col-md-4">
                            <label asp-for="AssignedDate" class="form-label"></label>
                            <input asp-for="AssignedDate" type="date" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="DueDate" class="form-label"></label>
                            <input asp-for="DueDate" type="date" class="form-control" />
                            <span asp-validation-for="DueDate" class="text-danger fs-xs"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="MaxScore" class="form-label"></label>
                            <input asp-for="MaxScore" type="number" step="0.01" class="form-control num" />
                        </div>
                        <div class="col-md-8">
                            <label asp-for="Attachment" class="form-label"></label>
                            <input asp-for="Attachment" type="file" class="form-control" />
                            @if (!string.IsNullOrEmpty(Model.AttachmentPath))
                            {
                                <div class="form-text fs-xs">
                                    المرفق الحالي: <a href="@Model.AttachmentPath" target="_blank">عرض الملف</a>
                                </div>
                            }
                            <span asp-validation-for="Attachment" class="text-danger fs-xs"></span>
                        </div>

                        <div class="col-12">
                            <div class="form-check">
                                <input asp-for="IsPublished" class="form-check-input" />
                                <label asp-for="IsPublished" class="form-check-label"></label>
                                <div class="form-text fs-xs">عند النشر يصل إشعار للطلاب بموعد التسليم.</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex gap-2">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i> حفظ</button>
                    <a class="btn btn-light" asp-action="Index">إلغاء</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}
