@model OutboxViewModel
@{
    ViewData["Title"] = "صادر الرسائل";
}

<div class="page-head">
    <div>
        <h1>صادر SMS / واتساب</h1>
        <p class="sub">
            قائمة الرسائل الخارجية المُولَّدة من النظام (الغياب، الرسوم، النتائج، التنبيهات)
        </p>
    </div>
    <div class="actions d-flex gap-2">
        @if (Model.QueuedCount > 0)
        {
            <form asp-action="ProcessOutbox" method="post">
                <button class="btn btn-primary" data-confirm="سيتم إرسال الرسائل المنتظرة عبر المزوّد المُعدّ. متابعة؟">
                    <i class="bi bi-send-check me-1"></i> إرسال المنتظر (@Model.QueuedCount)
                </button>
            </form>
        }
        <a class="btn btn-light" asp-controller="Settings" asp-action="Index"><i class="bi bi-gear me-1"></i> الإعدادات</a>
    </div>
</div>

@if (!Model.SmsEnabled && !Model.WhatsAppEnabled)
{
    <div class="alert alert-warning d-flex gap-2">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <div>
            خدمات الرسائل الخارجية غير مفعّلة حالياً — الرسائل تُخزَّن في قائمة الانتظار فقط.
            فعّل SMS أو واتساب من <a asp-controller="Settings" asp-action="Index">إعدادات المدرسة</a> واربط مزوّد الخدمة.
        </div>
    </div>
}

<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3">
        <div class="stat-card"><div class="ico tone-info"><i class="bi bi-hourglass-split"></i></div>
            <div><div class="value num">@Model.QueuedCount.ToString("N0")</div><div class="label">في الانتظار</div></div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card"><div class="ico tone-ok"><i class="bi bi-check-circle"></i></div>
            <div><div class="value num">@Model.SentCount.ToString("N0")</div><div class="label">تم الإرسال</div></div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card"><div class="ico tone-danger"><i class="bi bi-x-circle"></i></div>
            <div><div class="value num">@Model.FailedCount.ToString("N0")</div><div class="label">فشل</div></div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="ico @(Model.SmsEnabled || Model.WhatsAppEnabled ? "tone-ok" : "tone-warn")"><i class="bi bi-broadcast"></i></div>
            <div>
                <div class="value" style="font-size:1.1rem">
                    @(Model.WhatsAppEnabled ? "واتساب" : Model.SmsEnabled ? "SMS" : "معطّل")
                </div>
                <div class="label">القناة النشطة</div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label">بحث</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input name="q" value="@Model.Q" class="form-control" placeholder="رقم الجوال، الاسم، النص..." />
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label">الحالة</label>
                <select name="status" class="form-select form-select-sm" data-autosubmit>
                    <option value="">الكل</option>
                    @foreach (var (v, t) in ViewHelpers.Options<OutboxStatus>())
                    {
                        <option value="@((int)v)" selected="@(Model.Status == v)">@t</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">القناة</label>
                <select name="channel" class="form-select form-select-sm" data-autosubmit>
                    <option value="">الكل</option>
                    @foreach (var (v, t) in ViewHelpers.Options<OutboxChannel>())
                    {
                        <option value="@((int)v)" selected="@(Model.Channel == v)">@t</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-1">
                <button class="btn btn-sm btn-primary flex-grow-1" aria-label="تطبيق التصفية"><i class="bi bi-funnel"></i></button>
                <a asp-action="Outbox" class="btn btn-sm btn-light" aria-label="مسح الفلاتر"><i class="bi bi-x-lg"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="table-wrap">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
            <tr>
                <th>المستلم</th>
                <th>القناة</th>
                <th>النص</th>
                <th>الحالة</th>
                <th>الإنشاء</th>
                <th>الإرسال</th>
                <th style="width:50px"></th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Items.TotalCount == 0)
            {
                <tr><td colspan="7"><div class="empty-state"><i class="bi bi-send"></i>لا توجد رسائل</div></td></tr>
            }
            @foreach (var m in Model.Items.Items)
            {
                <tr>
                    <td>
                        <div class="fw-semibold fs-sm">@(m.RecipientName ?? "—")</div>
                        <div class="fs-xs text-muted-3 num" dir="ltr">@m.Recipient</div>
                    </td>
                    <td>
                        <span class="chip @(m.Channel == OutboxChannel.WhatsApp ? "tone-ok" : "tone-brand")">
                            <i class="bi @(m.Channel == OutboxChannel.WhatsApp ? "bi-whatsapp" : m.Channel == OutboxChannel.Email ? "bi-envelope" : "bi-chat-text")"></i>
                            @m.Channel.Display()
                        </span>
                    </td>
                    <td>
                        <div class="fs-sm text-muted-2" style="max-width:420px;white-space:pre-line">@m.Body</div>
                    </td>
                    <td>
                        @m.Status.Badge()
                        @if (!string.IsNullOrEmpty(m.Error))
                        {
                            <div class="fs-xs text-danger">@m.Error</div>
                        }
                    </td>
                    <td class="num fs-xs text-muted-2">@ViewHelpers.DateTimeShort(m.CreatedAt)</td>
                    <td class="num fs-xs text-muted-2">@ViewHelpers.DateTimeShort(m.SentAt)</td>
                    <td>
                        @if (m.Status == OutboxStatus.Queued)
                        {
                            <form asp-action="CancelOutbox" method="post">
                                <input type="hidden" name="id" value="@m.Id" />
                                <button class="btn btn-sm btn-light text-danger" data-confirm="إلغاء هذه الرسالة؟" aria-label="حذف"><i class="bi bi-x"></i></button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="Model.Items" />
</div>
