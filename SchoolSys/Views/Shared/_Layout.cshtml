@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var act = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var area = ViewContext.RouteData.Values["area"]?.ToString() ?? "";

    string Active(string controller, string? action = null, string? inArea = null)
    {
        var ok = string.Equals(ctrl, controller, StringComparison.OrdinalIgnoreCase)
                 && string.Equals(area, inArea ?? "", StringComparison.OrdinalIgnoreCase);
        if (ok && action is not null)
            ok = string.Equals(act, action, StringComparison.OrdinalIgnoreCase);
        return ok ? "active" : "";
    }

    var schoolName = ViewBag.SchoolName as string ?? "نظام إدارة المدرسة";
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0b1f4b" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="@schoolName" />
    <title>@ViewData["Title"] — @schoolName</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/responsive.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

@* أول عنصر يصله مستخدم لوحة المفاتيح — يتخطى نحو 40 رابطاً في القائمة الجانبية *@
<a class="skip-link" href="#mainContent">تخطّي إلى المحتوى الرئيسي</a>

<aside class="app-sidebar" id="appSidebar" aria-label="القائمة الرئيسية">
    <div class="brand">
        <div class="brand-mark"><i class="bi bi-mortarboard-fill"></i></div>
        <div class="brand-text">
            <b>@schoolName</b>
            <span>نظام الإدارة المتكامل</span>
        </div>
        <button class="sidebar-close" id="sidebarClose" type="button" aria-label="إغلاق القائمة">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>

    <nav class="sidebar-scroll">
        <a class="nav-link @Active("Dashboard")" asp-controller="Dashboard" asp-action="Index">
            <i class="bi bi-speedometer2"></i> لوحة التحكم
        </a>

        @if (User.CanAny(Permissions.StudentsView, Permissions.GuardiansView))
        {
            <div class="nav-group-title">شؤون الطلاب</div>
            @if (User.Can(Permissions.StudentsView))
            {
                <a class="nav-link @Active("Students")" asp-controller="Students" asp-action="Index">
                    <i class="bi bi-mortarboard"></i> الطلاب
                </a>
            }
            @if (User.Can(Permissions.GuardiansView))
            {
                <a class="nav-link @Active("Guardians")" asp-controller="Guardians" asp-action="Index">
                    <i class="bi bi-people"></i> أولياء الأمور
                </a>
            }
        }

        @if (User.Can(Permissions.EmployeesView))
        {
            <div class="nav-group-title">الكادر المدرسي</div>
            <a class="nav-link @Active("Employees")" asp-controller="Employees" asp-action="Index">
                <i class="bi bi-person-badge"></i> الموظفون والمعلمون
            </a>
        }

        @if (User.CanAny(Permissions.AcademicView, Permissions.TimetableView))
        {
            <div class="nav-group-title">الشؤون الأكاديمية</div>
            @if (User.Can(Permissions.AcademicView))
            {
                <a class="nav-link @Active("Academic", "Index")" asp-controller="Academic" asp-action="Index">
                    <i class="bi bi-building"></i> البنية الأكاديمية
                </a>
                <a class="nav-link @Active("Academic", "TeachingLoad")" asp-controller="Academic" asp-action="TeachingLoad">
                    <i class="bi bi-diagram-3"></i> توزيع المواد
                </a>
            }
            @if (User.Can(Permissions.TimetableView))
            {
                <a class="nav-link @Active("Timetable")" asp-controller="Timetable" asp-action="Index">
                    <i class="bi bi-calendar3-week"></i> الجداول الدراسية
                </a>
            }
        }

        @if (User.Can(Permissions.AttendanceView))
        {
            <div class="nav-group-title">الحضور والانصراف</div>
            <a class="nav-link @Active("Attendance", "Index")" asp-controller="Attendance" asp-action="Index">
                <i class="bi bi-calendar-check"></i> حضور الطلاب
            </a>
            @if (User.Can(Permissions.AttendanceTakeStaff))
            {
                <a class="nav-link @Active("Attendance", "Staff")" asp-controller="Attendance" asp-action="Staff">
                    <i class="bi bi-person-check"></i> حضور الموظفين
                </a>
            }
            @if (User.Can(Permissions.AttendanceTakeStudents))
            {
                <a class="nav-link @Active("Attendance", "Scan")" asp-controller="Attendance" asp-action="Scan">
                    <i class="bi bi-qr-code-scan"></i> تسجيل بـ QR
                </a>
            }
            @if (User.Can(Permissions.AttendanceReports))
            {
                <a class="nav-link @Active("Attendance", "Reports")" asp-controller="Attendance" asp-action="Reports">
                    <i class="bi bi-clipboard-data"></i> تقارير الحضور
                </a>
            }
        }

        @if (User.CanAny(Permissions.ExamsView, Permissions.ResultsView, Permissions.HomeworkView))
        {
            <div class="nav-group-title">التقييم والدرجات</div>
            @if (User.Can(Permissions.ExamsView))
            {
                <a class="nav-link @Active("Exams")" asp-controller="Exams" asp-action="Index">
                    <i class="bi bi-journal-check"></i> الاختبارات
                </a>
            }
            @if (User.Can(Permissions.ResultsView))
            {
                <a class="nav-link @Active("Results")" asp-controller="Results" asp-action="Index">
                    <i class="bi bi-award"></i> النتائج والشهادات
                </a>
            }
            @if (User.Can(Permissions.HomeworkView))
            {
                <a class="nav-link @Active("Homework")" asp-controller="Homework" asp-action="Index">
                    <i class="bi bi-pencil-square"></i> الواجبات
                </a>
            }
        }

        @if (User.Can(Permissions.FinanceView))
        {
            <div class="nav-group-title">الرسوم والمحاسبة</div>
            <a class="nav-link @Active("Finance", "Index")" asp-controller="Finance" asp-action="Index">
                <i class="bi bi-cash-coin"></i> نظرة عامة
            </a>
            <a class="nav-link @Active("Finance", "Invoices")" asp-controller="Finance" asp-action="Invoices">
                <i class="bi bi-receipt"></i> الفواتير
            </a>
            <a class="nav-link @Active("Finance", "Payments")" asp-controller="Finance" asp-action="Payments">
                <i class="bi bi-credit-card"></i> المدفوعات
            </a>
            <a class="nav-link @Active("Finance", "Overdue")" asp-controller="Finance" asp-action="Overdue">
                <i class="bi bi-exclamation-triangle"></i> المتأخرات
            </a>
            @if (User.Can(Permissions.FinanceFeeItems))
            {
                <a class="nav-link @Active("Finance", "FeeItems")" asp-controller="Finance" asp-action="FeeItems">
                    <i class="bi bi-list-check"></i> بنود الرسوم
                </a>
            }
        }

        @if (User.Can(Permissions.TransportView))
        {
            <div class="nav-group-title">النقل المدرسي</div>
            <a class="nav-link @Active("Transport", "Index")" asp-controller="Transport" asp-action="Index">
                <i class="bi bi-bus-front"></i> الحافلات
            </a>
            <a class="nav-link @Active("Transport", "Routes")" asp-controller="Transport" asp-action="Routes">
                <i class="bi bi-signpost-split"></i> خطوط السير
            </a>
            <a class="nav-link @Active("Transport", "Subscriptions")" asp-controller="Transport" asp-action="Subscriptions">
                <i class="bi bi-person-vcard"></i> اشتراكات الطلاب
            </a>
            @if (User.Can(Permissions.TransportLog))
            {
                <a class="nav-link @Active("Transport", "Logs")" asp-controller="Transport" asp-action="Logs">
                    <i class="bi bi-box-arrow-in-left"></i> الصعود والنزول
                </a>
            }
        }

        <div class="nav-group-title">التواصل</div>
        @if (User.Can(Permissions.AnnouncementsView))
        {
            <a class="nav-link @Active("Communication", "Announcements")" asp-controller="Communication" asp-action="Announcements">
                <i class="bi bi-megaphone"></i> الإعلانات
            </a>
        }
        @if (User.Can(Permissions.MessagesUse))
        {
            <a class="nav-link @Active("Communication", "Messages")" asp-controller="Communication" asp-action="Messages">
                <i class="bi bi-chat-dots"></i> الرسائل الداخلية
            </a>
        }
        <a class="nav-link @Active("Communication", "Notifications")" asp-controller="Communication" asp-action="Notifications">
            <i class="bi bi-bell"></i> الإشعارات
        </a>
        @if (User.Can(Permissions.NotificationsSend))
        {
            <a class="nav-link @Active("Communication", "Outbox")" asp-controller="Communication" asp-action="Outbox">
                <i class="bi bi-send"></i> صادر SMS / واتساب
            </a>
        }

        @if (User.IsInRole(RoleNames.Student) || User.IsInRole(RoleNames.Guardian) || User.IsInRole(RoleNames.Teacher))
        {
            <div class="nav-group-title">بوابتي</div>
            @if (User.IsInRole(RoleNames.Student))
            {
                <a class="nav-link @Active("Student", null, "Portal")" asp-area="Portal" asp-controller="Student" asp-action="Index">
                    <i class="bi bi-person-workspace"></i> بوابة الطالب
                </a>
            }
            @if (User.IsInRole(RoleNames.Guardian))
            {
                <a class="nav-link @Active("Guardian", null, "Portal")" asp-area="Portal" asp-controller="Guardian" asp-action="Index">
                    <i class="bi bi-people-fill"></i> بوابة ولي الأمر
                </a>
            }
            @if (User.IsInRole(RoleNames.Teacher))
            {
                <a class="nav-link @Active("Teacher", null, "Portal")" asp-area="Portal" asp-controller="Teacher" asp-action="Index">
                    <i class="bi bi-easel"></i> بوابة المعلم
                </a>
            }
        }

        @if (User.Can(Permissions.ReportsView))
        {
            <div class="nav-group-title">التقارير</div>
            <a class="nav-link @Active("Reports")" asp-controller="Reports" asp-action="Index">
                <i class="bi bi-file-earmark-bar-graph"></i> مركز التقارير
            </a>
        }

        @if (User.CanAny(Permissions.UsersView, Permissions.RolesView, Permissions.SettingsManage, Permissions.AuditView))
        {
            <div class="nav-group-title">إدارة النظام</div>
            @if (User.Can(Permissions.UsersView))
            {
                <a class="nav-link @Active("Users")" asp-controller="Users" asp-action="Index">
                    <i class="bi bi-person-gear"></i> المستخدمون
                </a>
            }
            @if (User.Can(Permissions.RolesView))
            {
                <a class="nav-link @Active("Roles")" asp-controller="Roles" asp-action="Index">
                    <i class="bi bi-shield-lock"></i> الأدوار والصلاحيات
                </a>
            }
            @if (User.Can(Permissions.SettingsManage))
            {
                <a class="nav-link @Active("Settings")" asp-controller="Settings" asp-action="Index">
                    <i class="bi bi-gear"></i> إعدادات المدرسة
                </a>
            }
            @if (User.Can(Permissions.AuditView))
            {
                <a class="nav-link @Active("Audit")" asp-controller="Audit" asp-action="Index">
                    <i class="bi bi-clock-history"></i> سجل التدقيق
                </a>
            }
        }
    </nav>
</aside>

<div class="sidebar-backdrop" id="sidebarBackdrop"></div>

<header class="app-topbar">
    <button class="icon-btn d-lg-none" id="sidebarToggle" type="button" aria-label="القائمة">
        <i class="bi bi-list"></i>
    </button>

    <form class="topbar-search" asp-controller="Students" asp-action="Index" method="get" role="search">
        <label for="topbarSearch" class="visually-hidden">بحث عن طالب</label>
        <input id="topbarSearch" name="q" type="search"
               value="@(ViewContext.HttpContext.Request.Query["q"])"
               placeholder="بحث عن طالب بالاسم أو الرقم..." autocomplete="off" />
        <i class="bi bi-search" aria-hidden="true"></i>
    </form>

    <div class="ms-auto d-flex align-items-center gap-2">
        <a class="icon-btn d-none d-sm-grid" asp-controller="Attendance" asp-action="Scan" title="تسجيل الحضور بـ QR">
            <i class="bi bi-qr-code-scan"></i>
        </a>

        <div class="dropdown">
            <button class="icon-btn" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside"
                    aria-label="الإشعارات" aria-describedby="notifCount">
                <i class="bi bi-bell" aria-hidden="true"></i>
                <span class="dot d-none" id="notifCount">0</span>
            </button>
            <div class="dropdown-menu dropdown-menu-start p-0" style="width:340px">
                <div class="d-flex align-items-center justify-content-between px-3 pt-2 pb-1">
                    <strong class="fs-sm">الإشعارات</strong>
                    <button class="btn btn-sm btn-link p-0 fs-xs" id="markAllRead">تعليم الكل كمقروء</button>
                </div>
                <div class="divider my-1"></div>
                <div class="notif-list px-2 pb-2" id="notifList">
                    <div class="text-center text-muted-3 py-4 fs-sm">لا توجد إشعارات</div>
                </div>
                <div class="border-top p-2 text-center">
                    <a class="fs-xs" asp-controller="Communication" asp-action="Notifications">عرض كل الإشعارات</a>
                </div>
            </div>
        </div>

        <div class="dropdown">
            <button class="user-chip" type="button" data-bs-toggle="dropdown">
                <div class="avatar">
                    @if (!string.IsNullOrEmpty(User.Photo()))
                    {
                        <img src="@User.Photo()" alt="" />
                    }
                    else
                    {
                        @User.Initials()
                    }
                </div>
                <div class="u-meta text-end lh-sm">
                    <div class="fw-bold fs-sm">@User.DisplayName()</div>
                    <div class="fs-xs text-muted-3">@User.PrimaryRole()</div>
                </div>
                <i class="bi bi-chevron-down fs-xs text-muted-3"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-start">
                <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-2"></i>ملفي الشخصي</a></li>
                <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-key me-2"></i>تغيير كلمة المرور</a></li>
                <li><hr class="dropdown-divider" /></li>
                <li>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>تسجيل الخروج</button>
                    </form>
                </li>
            </ul>
        </div>
    </div>
</header>

<main class="app-main" id="mainContent" tabindex="-1">
    <partial name="_Alerts" />
    @RenderBody()
</main>

@* منطقة إعلان مستقرة لقارئات الشاشة — تُحدَّث نصياً عند وصول إشعار *@
<div id="liveStatus" class="visually-hidden" role="status" aria-live="polite" aria-atomic="true"></div>

<partial name="_MobileNav" />

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/signalr/signalr.min.js"></script>
<script src="~/js/app.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
@* يُحمَّل أخيراً ليعمل على أي جداول أضافتها الصفحة *@
<script src="~/js/responsive.js" asp-append-version="true"></script>
</body>
</html>
