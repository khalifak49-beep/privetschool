@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var act = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var area = ViewContext.RouteData.Values["area"]?.ToString() ?? "";

    string Active(string controller, string? action = null, string? inArea = null)
    {
        var ok = string.Equals(ctrl, controller, StringComparison.OrdinalIgnoreCase)
                 && string.Equals(area, inArea ?? "", StringComparison.OrdinalIgnoreCase);
        if (ok && action is not null)
            ok = string.Equals(act, action, StringComparison.OrdinalIgnoreCase);
        return ok ? "active" : "";
    }

    var schoolName = ViewBag.SchoolName as string ?? "نظام إدارة المدرسة";
    var logoPath = ViewBag.LogoPath as string;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    @* يُطبَّق جانب القائمة قبل أول رسم حتى لا تقفز الصفحة عند التحميل *@
    <script>
        (function () {
            try {
                if (localStorage.getItem('sidebarSide') === 'left')
                    document.documentElement.setAttribute('data-sidebar', 'left');
            } catch (e) { }
        })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0b1f4b" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="@schoolName" />
    <title>@ViewData["Title"] — @schoolName</title>
    @* أيقونة التبويب وأيقونة الاختصار على الجوال تتبعان شعار المدرسة *@
    @if (!string.IsNullOrEmpty(logoPath))
    {
        <link rel="icon" href="@logoPath" />
        <link rel="apple-touch-icon" href="@logoPath" />
    }
    else
    {
        <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
        <link rel="apple-touch-icon" href="~/favicon.svg" />
    }
    @* المقطع العربي هو الحرج للعرض الأول، فنحمّله مبكراً *@
    <link rel="preload" href="~/lib/cairo/files/cairo-arabic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/lib/cairo/cairo.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/responsive.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

@* أول عنصر يصله مستخدم لوحة المفاتيح — يتخطى نحو 40 رابطاً في القائمة الجانبية *@
<a class="skip-link" href="#mainContent">تخطّي إلى المحتوى الرئيسي</a>

<aside class="app-sidebar" id="appSidebar" aria-label="القائمة الرئيسية">
    <div class="brand">
        @await Html.PartialAsync("_SchoolLogo", new LogoOptions("42px", "12px"))
        <div class="brand-text">
            <b>@schoolName</b>
            <span>نظام الإدارة المتكامل</span>
        </div>
        <button class="sidebar-close" id="sidebarClose" type="button" aria-label="إغلاق القائمة">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>

    <nav class="sidebar-scroll" id="sidebarNav">
        @* رابط مفرد خارج المجموعات *@
        <a class="nav-link @Active("Dashboard")" asp-area="" asp-controller="Dashboard" asp-action="Index">
            <i class="bi bi-speedometer2" aria-hidden="true"></i> لوحة التحكم
        </a>

        @if (User.CanAny(Permissions.StudentsView, Permissions.GuardiansView))
        {
            <div class="nav-group" data-group="students">
                <button class="nav-group-head" type="button" aria-expanded="false">
                    <i class="bi bi-people-fill ngh-icon" aria-hidden="true"></i>
                    <span class="ngh-text">شؤون الطلاب</span>
                    <i class="bi bi-chevron-down ngh-caret" aria-hidden="true"></i>
                </button>
                <div class="nav-group-body"><div class="ngb-inner">
                    @if (User.Can(Permissions.StudentsView))
                    {
                        <a class="nav-link @Active("Students")" asp-area="" asp-controller="Students" asp-action="Index">
                            <i class="bi bi-mortarboard" aria-hidden="true"></i> الطلاب
                        </a>
                    }
                    @if (User.Can(Permissions.GuardiansView))
                    {
                        <a class="nav-link @Active("Guardians")" asp-area="" asp-controller="Guardians" asp-action="Index">
                            <i class="bi bi-people" aria-hidden="true"></i> أولياء الأمور
                        </a>
                    }
                </div></div>
            </div>
        }

        @if (User.Can(Permissions.EmployeesView))
        {
            <div class="nav-group" data-group="staff">
                <button class="nav-group-head" type="button" aria-expanded="false">
                    <i class="bi bi-person-badge-fill ngh-icon" aria-hidden="true"></i>
                    <span class="ngh-text">الكادر المدرسي</span>
                    <i class="bi bi-chevron-down ngh-caret" aria-hidden="true"></i>
                </button>
                <div class="nav-group-body"><div class="ngb-inner">
                    <a class="nav-link @Active("Employees")" asp-area="" asp-controller="Employees" asp-action="Index">
                        <i class="bi bi-person-badge" aria-hidden="true"></i> الموظفون والمعلمون
                    </a>
                </div></div>
            </div>
        }

        @if (User.CanAny(Permissions.AcademicView, Permissions.TimetableView))
        {
            <div class="nav-group" data-group="academic">
                <button class="nav-group-head" type="button" aria-expanded="false">
                    <i class="bi bi-building-fill ngh-icon" aria-hidden="true"></i>
                    <span class="ngh-text">الشؤون الأكاديمية</span>
                    <i class="bi bi-chevron-down ngh-caret" aria-hidden="true"></i>
                </button>
                <div class="nav-group-body"><div class="ngb-inner">
                    @if (User.Can(Permissions.AcademicView))
                    {
                        <a class="nav-link @Active("Academic", "Index")" asp-area="" asp-controller="Academic" asp-action="Index">
                            <i class="bi bi-building" aria-hidden="true"></i> البنية الأكاديمية
                        </a>
                        <a class="nav-link @Active("Academic", "TeachingLoad")" asp-area="" asp-controller="Academic" asp-action="TeachingLoad">
                            <i class="bi bi-diagram-3" aria-hidden="true"></i> توزيع المواد
                        </a>
                    }
                    @if (User.Can(Permissions.TimetableView))
                    {
                        <a class="nav-link @Active("Timetable")" asp-area="" asp-controller="Timetable" asp-action="Index">
                            <i class="bi bi-calendar3-week" aria-hidden="true"></i> الجداول الدراسية
                        </a>
                    }
                </div></div>
            </div>
        }

        @if (User.Can(Permissions.AttendanceView))
        {
            <div class="nav-group" data-group="attendance">
                <button class="nav-group-head" type="button" aria-expanded="false">
                    <i class="bi bi-calendar-check-fill ngh-icon" aria-hidden="true"></i>
                    <span class="ngh-text">الحضور والانصراف</span>
                    <i class="bi bi-chevron-down ngh-caret" aria-hidden="true"></i>
                </button>
                <div class="nav-group-body"><div class="ngb-inner">
                    <a class="nav-link @Active("Attendance", "Index")" asp-area="" asp-controller="Attendance" asp-action="Index">
                        <i class="bi bi-calendar-check" aria-hidden="true"></i> حضور الطلاب
                    </a>
                    @if (User.Can(Permissions.AttendanceTakeStaff))
                    {
                        <a class="nav-link @Active("Attendance", "Staff")" asp-area="" asp-controller="Attendance" asp-action="Staff">
                            <i class="bi bi-person-check" aria-hidden="true"></i> حضور الموظفين
                        </a>
                    }
                    @if (User.Can(Permissions.AttendanceTakeStudents))
                    {
                        <a class="nav-link @Active("Attendance", "Scan")" asp-area="" asp-controller="Attendance" asp-action="Scan">
                            <i class="bi bi-qr-code-scan" aria-hidden="true"></i> تسجيل بـ QR
                        </a>
                    }
                    @if (User.Can(Permissions.AttendanceReports))
                    {
                        <a class="nav-link @Active("Attendance", "Reports")" asp-area="" asp-controller="Attendance" asp-action="Reports">
                            <i class="bi bi-clipboard-data" aria-hidden="true"></i> تقارير الحضور
                        </a>
                    }
                </div></div>
            </div>
        }

        @if (User.CanAny(Permissions.ExamsView, Permissions.ResultsView, Permissions.HomeworkView))
        {
            <div class="nav-group" data-group="assessment">
                <button class="nav-group-head" type="button" aria-expanded="false">
                    <i class="bi bi-journal-check ngh-icon" aria-hidden="true"></i>
                    <span class="ngh-text">التقييم والدرجات</span>
                    <i class="bi bi-chevron-down ngh-caret" aria-hidden="true"></i>
                </button>
                <div class="nav-group-body"><div class="ngb-inner">
                    @if (User.Can(Permissions.ExamsView))
                    {
                        <a class="nav-link @Active("Exams")" asp-area="" asp-controller="Exams" asp-action="Index">
                            <i class="bi bi-journal-check" aria-hidden="true"></i> الاختبارات
                        </a>
                    }
                    @if (User.Can(Permissions.ResultsView))
                    {
                        <a class="nav-link @Active("Results")" asp-area="" asp-controller="Results" asp-action="Index">
                            <i class="bi bi-award" aria-hidden="true"></i> النتائج والشهادات
                        </a>
                    }
                    @if (User.Can(Permissions.HomeworkView))
                    {
                        <a class="nav-link @Active("Homework")" asp-area="" asp-controller="Homework" asp-action="Index">
                            <i class="bi bi-pencil-square" aria-hidden="true"></i> الواجبات
                        </a>
                    }
                </div></div>
            </div>
        }

        @if (User.Can(Permissions.FinanceView))
        {
            <div class="nav-group" data-group="finance">
                <button class="nav-group-head" type="button" aria-expanded="false">
                    <i class="bi bi-cash-coin ngh-icon" aria-hidden="true"></i>
                    <span class="ngh-text">الرسوم والمحاسبة</span>
                    <i class="bi bi-chevron-down ngh-caret" aria-hidden="true"></i>
                </button>
                <div class="nav-group-body"><div class="ngb-inner">
                    <a class="nav-link @Active("Finance", "Index")" asp-area="" asp-controller="Finance" asp-action="Index">
                        <i class="bi bi-graph-up" aria-hidden="true"></i> نظرة عامة
                    </a>
                    <a class="nav-link @Active("Finance", "Invoices")" asp-area="" asp-controller="Finance" asp-action="Invoices">
                        <i class="bi bi-receipt" aria-hidden="true"></i> الفواتير
                    </a>
                    <a class="nav-link @Active("Finance", "Payments")" asp-area="" asp-controller="Finance" asp-action="Payments">
                        <i class="bi bi-credit-card" aria-hidden="true"></i> المدفوعات
                    </a>
                    <a class="nav-link @Active("Finance", "Overdue")" asp-area="" asp-controller="Finance" asp-action="Overdue">
                        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i> المتأخرات
                    </a>
                    @if (User.Can(Permissions.FinanceFeeItems))
                    {
                        <a class="nav-link @Active("Finance", "FeeItems")" asp-area="" asp-controller="Finance" asp-action="FeeItems">
                            <i class="bi bi-list-check" aria-hidden="true"></i> بنود الرسوم
                        </a>
                    }
                </div></div>
            </div>
        }

        @if (User.Can(Permissions.TransportView))
        {
            <div class="nav-group" data-group="transport">
                <button class="nav-group-head" type="button" aria-expanded="false">
                    <i class="bi bi-bus-front-fill ngh-icon" aria-hidden="true"></i>
                    <span class="ngh-text">النقل المدرسي</span>
                    <i class="bi bi-chevron-down ngh-caret" aria-hidden="true"></i>
                </button>
                <div class="nav-group-body"><div class="ngb-inner">
                    <a class="nav-link @Active("Transport", "Index")" asp-area="" asp-controller="Transport" asp-action="Index">
                        <i class="bi bi-bus-front" aria-hidden="true"></i> الحافلات
                    </a>
                    <a class="nav-link @Active("Transport", "Routes")" asp-area="" asp-controller="Transport" asp-action="Routes">
                        <i class="bi bi-signpost-split" aria-hidden="true"></i> خطوط السير
                    </a>
                    <a class="nav-link @Active("Transport", "Subscriptions")" asp-area="" asp-controller="Transport" asp-action="Subscriptions">
                        <i class="bi bi-person-vcard" aria-hidden="true"></i> اشتراكات الطلاب
                    </a>
                    @if (User.Can(Permissions.TransportLog))
                    {
                        <a class="nav-link @Active("Transport", "Logs")" asp-area="" asp-controller="Transport" asp-action="Logs">
                            <i class="bi bi-box-arrow-in-left" aria-hidden="true"></i> الصعود والنزول
                        </a>
                    }
                </div></div>
            </div>
        }

        <div class="nav-group" data-group="comms">
            <button class="nav-group-head" type="button" aria-expanded="false">
                <i class="bi bi-chat-dots-fill ngh-icon" aria-hidden="true"></i>
                <span class="ngh-text">التواصل</span>
                <i class="bi bi-chevron-down ngh-caret" aria-hidden="true"></i>
            </button>
            <div class="nav-group-body"><div class="ngb-inner">
                @if (User.Can(Permissions.AnnouncementsView))
                {
                    <a class="nav-link @Active("Communication", "Announcements")" asp-area="" asp-controller="Communication" asp-action="Announcements">
                        <i class="bi bi-megaphone" aria-hidden="true"></i> الإعلانات
                    </a>
                }
                @if (User.Can(Permissions.MessagesUse))
                {
                    <a class="nav-link @Active("Communication", "Messages")" asp-area="" asp-controller="Communication" asp-action="Messages">
                        <i class="bi bi-chat-dots" aria-hidden="true"></i> الرسائل الداخلية
                    </a>
                }
                <a class="nav-link @Active("Communication", "Notifications")" asp-area="" asp-controller="Communication" asp-action="Notifications">
                    <i class="bi bi-bell" aria-hidden="true"></i> الإشعارات
                </a>
                @if (User.Can(Permissions.NotificationsSend))
                {
                    <a class="nav-link @Active("Communication", "Outbox")" asp-area="" asp-controller="Communication" asp-action="Outbox">
                        <i class="bi bi-send" aria-hidden="true"></i> صادر SMS / واتساب
                    </a>
                }
            </div></div>
        </div>

        @if (User.IsInRole(RoleNames.Student) || User.IsInRole(RoleNames.Guardian) || User.IsInRole(RoleNames.Teacher))
        {
            @* بوابة المستخدم تبقى ظاهرة دائماً لأنها وجهته الأساسية *@
            @if (User.IsInRole(RoleNames.Student))
            {
                <a class="nav-link @Active("Student", null, "Portal")" asp-area="Portal" asp-controller="Student" asp-action="Index">
                    <i class="bi bi-person-workspace" aria-hidden="true"></i> بوابة الطالب
                </a>
                <a class="nav-link @Active("Student", "Timetable", "Portal")" asp-area="Portal" asp-controller="Student" asp-action="Timetable">
                    <i class="bi bi-calendar3-week" aria-hidden="true"></i> جدولي الدراسي
                </a>
                <a class="nav-link @Active("Student", "Homework", "Portal")" asp-area="Portal" asp-controller="Student" asp-action="Homework">
                    <i class="bi bi-pencil-square" aria-hidden="true"></i> واجباتي
                </a>
                <a class="nav-link @Active("Student", "Attendance", "Portal")" asp-area="Portal" asp-controller="Student" asp-action="Attendance">
                    <i class="bi bi-calendar-check" aria-hidden="true"></i> سجل حضوري
                </a>
                <a class="nav-link @Active("Student", "Grades", "Portal")" asp-area="Portal" asp-controller="Student" asp-action="Grades">
                    <i class="bi bi-award" aria-hidden="true"></i> كشف درجاتي
                </a>
            }
            @if (User.IsInRole(RoleNames.Guardian))
            {
                <a class="nav-link @Active("Guardian", null, "Portal")" asp-area="Portal" asp-controller="Guardian" asp-action="Index">
                    <i class="bi bi-people-fill" aria-hidden="true"></i> بوابة ولي الأمر
                </a>
                <a class="nav-link @Active("Guardian", "Fees", "Portal")" asp-area="Portal" asp-controller="Guardian" asp-action="Fees">
                    <i class="bi bi-cash-coin" aria-hidden="true"></i> الرسوم والأقساط
                </a>
            }
            @if (User.IsInRole(RoleNames.Teacher))
            {
                <a class="nav-link @Active("Teacher", null, "Portal")" asp-area="Portal" asp-controller="Teacher" asp-action="Index">
                    <i class="bi bi-easel" aria-hidden="true"></i> بوابة المعلم
                </a>
            }
        }

        @if (User.Can(Permissions.ReportsView))
        {
            <a class="nav-link @Active("Reports")" asp-area="" asp-controller="Reports" asp-action="Index">
                <i class="bi bi-file-earmark-bar-graph" aria-hidden="true"></i> مركز التقارير
            </a>
        }

        @if (User.CanAny(Permissions.UsersView, Permissions.RolesView, Permissions.SettingsManage, Permissions.AuditView))
        {
            <div class="nav-group" data-group="system">
                <button class="nav-group-head" type="button" aria-expanded="false">
                    <i class="bi bi-gear-fill ngh-icon" aria-hidden="true"></i>
                    <span class="ngh-text">إدارة النظام</span>
                    <i class="bi bi-chevron-down ngh-caret" aria-hidden="true"></i>
                </button>
                <div class="nav-group-body"><div class="ngb-inner">
                    @if (User.Can(Permissions.UsersView))
                    {
                        <a class="nav-link @Active("Users")" asp-area="" asp-controller="Users" asp-action="Index">
                            <i class="bi bi-person-gear" aria-hidden="true"></i> المستخدمون
                        </a>
                    }
                    @if (User.Can(Permissions.RolesView))
                    {
                        <a class="nav-link @Active("Roles")" asp-area="" asp-controller="Roles" asp-action="Index">
                            <i class="bi bi-shield-lock" aria-hidden="true"></i> الأدوار والصلاحيات
                        </a>
                    }
                    @if (User.Can(Permissions.SettingsManage))
                    {
                        <a class="nav-link @Active("Settings")" asp-area="" asp-controller="Settings" asp-action="Index">
                            <i class="bi bi-gear" aria-hidden="true"></i> إعدادات المدرسة
                        </a>
                    }
                    @if (User.Can(Permissions.AuditView))
                    {
                        <a class="nav-link @Active("Audit")" asp-area="" asp-controller="Audit" asp-action="Index">
                            <i class="bi bi-clock-history" aria-hidden="true"></i> سجل التدقيق
                        </a>
                    }
                </div></div>
            </div>
        }
    </nav>
</aside>

<div class="sidebar-backdrop" id="sidebarBackdrop"></div>

<header class="app-topbar">
    <button class="icon-btn d-lg-none" id="sidebarToggle" type="button" aria-label="القائمة">
        <i class="bi bi-list"></i>
    </button>

    @* على الجوال تكون القائمة الجانبية مغلقة، فيحضر الشعار في الترويسة *@
    <a class="topbar-brand d-lg-none" asp-area="" asp-controller="Dashboard" asp-action="Index"
       aria-label="@schoolName — الانتقال إلى لوحة التحكم">
        @await Html.PartialAsync("_SchoolLogo", new LogoOptions("32px", "9px"))
    </a>

    <form class="topbar-search" asp-controller="Students" asp-action="Index" method="get" role="search">
        <label for="topbarSearch" class="visually-hidden">بحث عن طالب</label>
        <input id="topbarSearch" name="q" type="search"
               value="@(ViewContext.HttpContext.Request.Query["q"])"
               placeholder="بحث عن طالب بالاسم أو الرقم..." autocomplete="off" />
        <i class="bi bi-search" aria-hidden="true"></i>
    </form>

    <div class="ms-auto d-flex align-items-center gap-2">
        @if (User.Can(Permissions.AttendanceTakeStudents))
        {
            <a class="icon-btn d-none d-sm-grid" asp-area="" asp-controller="Attendance" asp-action="Scan"
               aria-label="تسجيل الحضور برمز QR" title="تسجيل الحضور بـ QR">
                <i class="bi bi-qr-code-scan" aria-hidden="true"></i>
            </a>
        }

        @* تبديل جانب القائمة بين اليمين واليسار *@
        <button class="icon-btn d-none d-lg-grid" type="button" id="sideToggle"
                aria-label="نقل القائمة الجانبية إلى الجانب الآخر" title="تبديل جانب القائمة">
            <i class="bi bi-layout-sidebar-inset-reverse" id="sideToggleIcon" aria-hidden="true"></i>
        </button>

        <div class="dropdown">
            <button class="icon-btn" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside"
                    aria-label="الإشعارات" aria-describedby="notifCount">
                <i class="bi bi-bell" aria-hidden="true"></i>
                <span class="dot d-none" id="notifCount">0</span>
            </button>
            <div class="dropdown-menu dropdown-menu-start p-0" style="width:340px">
                <div class="d-flex align-items-center justify-content-between px-3 pt-2 pb-1">
                    <strong class="fs-sm">الإشعارات</strong>
                    <button class="btn btn-sm btn-link p-0 fs-xs" id="markAllRead">تعليم الكل كمقروء</button>
                </div>
                <div class="divider my-1"></div>
                <div class="notif-list px-2 pb-2" id="notifList">
                    <div class="text-center text-muted-3 py-4 fs-sm">لا توجد إشعارات</div>
                </div>
                <div class="border-top p-2 text-center">
                    <a class="fs-xs" asp-controller="Communication" asp-action="Notifications">عرض كل الإشعارات</a>
                </div>
            </div>
        </div>

        <div class="dropdown">
            <button class="user-chip" type="button" data-bs-toggle="dropdown">
                <div class="avatar">
                    @if (!string.IsNullOrEmpty(User.Photo()))
                    {
                        <img src="@User.Photo()" alt="" />
                    }
                    else
                    {
                        @User.Initials()
                    }
                </div>
                <div class="u-meta text-end lh-sm">
                    <div class="fw-bold fs-sm">@User.DisplayName()</div>
                    <div class="fs-xs text-muted-3">@User.PrimaryRole()</div>
                </div>
                <i class="bi bi-chevron-down fs-xs text-muted-3"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-start">
                <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-2"></i>ملفي الشخصي</a></li>
                <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-key me-2"></i>تغيير كلمة المرور</a></li>
                <li><hr class="dropdown-divider" /></li>
                <li>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>تسجيل الخروج</button>
                    </form>
                </li>
            </ul>
        </div>
    </div>
</header>

<main class="app-main" id="mainContent" tabindex="-1">
    <partial name="_Alerts" />
    @RenderBody()
</main>

@* منطقة إعلان مستقرة لقارئات الشاشة — تُحدَّث نصياً عند وصول إشعار *@
<div id="liveStatus" class="visually-hidden" role="status" aria-live="polite" aria-atomic="true"></div>

<partial name="_MobileNav" />

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/signalr/signalr.min.js"></script>
<script src="~/js/app.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
@* يُحمَّل أخيراً ليعمل على أي جداول أضافتها الصفحة *@
<script src="~/js/responsive.js" asp-append-version="true"></script>
</body>
</html>
