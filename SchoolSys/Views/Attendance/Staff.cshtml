@model StaffAttendanceViewModel
@{
    ViewData["Title"] = "حضور الموظفين";
}

<div class="page-head">
    <div>
        <h1>حضور الموظفين والمعلمين</h1>
        <p class="sub">@ViewHelpers.Date(Model.Date) · @Model.Entries.Count موظف</p>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label">التاريخ</label>
                <input name="date" type="date" value="@Model.Date.ToString("yyyy-MM-dd")"
                       max="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control form-control-sm" data-autosubmit />
            </div>
            <div class="col-md-4">
                <label class="form-label">الوظيفة</label>
                <select name="type" class="form-select form-select-sm" data-autosubmit>
                    <option value="">الكل</option>
                    @foreach (var (v, t) in ViewHelpers.Options<EmployeeType>())
                    {
                        <option value="@((int)v)" selected="@(Model.Type == v)">@t</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <button class="btn btn-sm btn-primary"><i class="bi bi-arrow-repeat me-1"></i> عرض</button>
            </div>
        </form>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-4">
        <div class="stat-card"><div class="ico tone-ok"><i class="bi bi-check-circle"></i></div>
            <div><div class="value num" id="cntPresent">@Model.PresentCount</div><div class="label">حاضر</div></div></div>
    </div>
    <div class="col-4">
        <div class="stat-card"><div class="ico tone-danger"><i class="bi bi-x-circle"></i></div>
            <div><div class="value num" id="cntAbsent">@Model.AbsentCount</div><div class="label">غائب</div></div></div>
    </div>
    <div class="col-4">
        <div class="stat-card"><div class="ico tone-warn"><i class="bi bi-clock"></i></div>
            <div><div class="value num" id="cntLate">@Model.LateCount</div><div class="label">متأخر</div></div></div>
    </div>
</div>

<form asp-action="SaveStaff" method="post">
    <input type="hidden" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" />

    <div class="table-wrap">
        <div class="card-header">
            <h2>قائمة الموظفين</h2>
            <button type="button" class="btn btn-sm btn-light" onclick="markAll(1)">
                <i class="bi bi-check-all me-1"></i> تعيين الكل حاضر
            </button>
        </div>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                <tr>
                    <th style="width:44px">#</th>
                    <th>الموظف</th>
                    <th>الوظيفة</th>
                    <th style="width:320px">الحالة</th>
                    <th style="width:110px">الحضور</th>
                    <th style="width:110px">الانصراف</th>
                    <th>ملاحظات</th>
                </tr>
                </thead>
                <tbody>
                @for (var i = 0; i < Model.Entries.Count; i++)
                {
                    var e = Model.Entries[i];
                    <tr>
                        <td class="num text-muted-3">@(i + 1)</td>
                        <td>
                            <input type="hidden" name="entries[@i].EmployeeId" value="@e.EmployeeId" />
                            <div class="d-flex align-items-center gap-2">
                                <div class="avatar sm">
                                    @if (!string.IsNullOrEmpty(e.PhotoPath))
                                    {
                                        <img src="@e.PhotoPath" alt="" />
                                    }
                                    else
                                    {
                                        @ViewHelpers.Initials(e.FullName)
                                    }
                                </div>
                                <div class="min-w-0">
                                    <a asp-controller="Employees" asp-action="Details" asp-route-id="@e.EmployeeId"
                                       class="fw-semibold text-reset d-block text-truncate">@e.FullName</a>
                                    <div class="fs-xs text-muted-3 num">@e.EmployeeNo</div>
                                </div>
                            </div>
                        </td>
                        <td>@e.EmployeeType.Badge()</td>
                        <td>
                            <div class="btn-group btn-group-sm w-100 att-group">
                                @foreach (var (v, t) in ViewHelpers.Options<AttendanceStatus>())
                                {
                                    var id = $"sf-{i}-{(int)v}";
                                    var tone = v switch
                                    {
                                        AttendanceStatus.Present => "success",
                                        AttendanceStatus.Absent => "danger",
                                        AttendanceStatus.Late => "warning",
                                        AttendanceStatus.Excused => "info",
                                        _ => "secondary"
                                    };
                                    <input type="radio" class="btn-check" name="entries[@i].Status" value="@((int)v)"
                                           id="@id" autocomplete="off" checked="@(e.Status == v)" onchange="recount()" />
                                    <label class="btn btn-outline-@tone" for="@id" style="font-size:.7rem;padding:.28rem .28rem">@t</label>
                                }
                            </div>
                        </td>
                        <td>
                            <input type="time" name="entries[@i].CheckInTime" class="form-control form-control-sm num"
                                   value="@(e.CheckInTime?.ToString(@"hh\:mm"))" />
                            <input type="hidden" name="entries[@i].LateMinutes" value="@e.LateMinutes" />
                        </td>
                        <td>
                            <input type="time" name="entries[@i].CheckOutTime" class="form-control form-control-sm num"
                                   value="@(e.CheckOutTime?.ToString(@"hh\:mm"))" />
                        </td>
                        <td>
                            <input name="entries[@i].Notes" value="@e.Notes" class="form-control form-control-sm" placeholder="—" />
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="card-footer text-end">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i> حفظ الحضور</button>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        function recount() {
            const c = { 1: 0, 2: 0, 3: 0 };
            document.querySelectorAll('.att-group input:checked').forEach(function (el) {
                c[el.value] = (c[el.value] || 0) + 1;
            });
            document.getElementById('cntPresent').textContent = c[1] || 0;
            document.getElementById('cntAbsent').textContent = c[2] || 0;
            document.getElementById('cntLate').textContent = c[3] || 0;
        }

        function markAll(v) {
            document.querySelectorAll('.att-group input[value="' + v + '"]').forEach(el => el.checked = true);
            recount();
        }
    </script>
}
