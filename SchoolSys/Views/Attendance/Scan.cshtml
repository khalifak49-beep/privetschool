@model ScanViewModel
@{
    ViewData["Title"] = "تسجيل الحضور بـ QR";
}

<div class="page-head">
    <div>
        <h1>تسجيل الحضور برمز QR</h1>
        <p class="sub">
            امسح بطاقة الطالب بالكاميرا أو بجهاز الماسح الضوئي —
            <span class="chip tone-brand num">@Model.TodayScans عملية مسح اليوم</span>
        </p>
    </div>
    <div class="actions">
        <a class="btn btn-light" asp-action="Index"><i class="bi bi-list-check me-1"></i> التسجيل اليدوي</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card mb-3">
            <div class="card-header">
                <h2><i class="bi bi-upc-scan me-1"></i> إدخال الرمز</h2>
            </div>
            <div class="card-body">
                <label class="form-label">رمز الطالب أو الرقم الطلابي</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-qr-code"></i></span>
                    <input id="manualCode" class="form-control form-control-lg num" dir="ltr"
                           placeholder="امسح البطاقة أو اكتب الرقم..." autocomplete="off" autofocus />
                </div>
                <div class="form-text fs-xs">
                    ضع المؤشر في الحقل ثم امسح البطاقة بجهاز الماسح — سيُسجَّل الحضور تلقائياً.
                </div>

                <div class="divider"></div>

                <div class="mb-2 d-none" id="camPickWrap">
                    <label class="form-label fs-sm" for="camPick">الكاميرا المستخدمة</label>
                    <select class="form-select form-select-sm" id="camPick"></select>
                </div>

                <button class="btn btn-primary w-100" id="startCam">
                    <i class="bi bi-camera-video me-1"></i> تشغيل الكاميرا
                </button>
                <button class="btn btn-light w-100 mt-2 d-none" id="stopCam">
                    <i class="bi bi-stop-circle me-1"></i> إيقاف الكاميرا
                </button>

                @* رسائل الكاميرا تظهر هنا داخل الصفحة بدل نافذة منبثقة بنص إنجليزي *@
                <div id="camMsg" class="mt-3" role="alert" aria-live="assertive"></div>

                <div id="reader" class="mt-3 rounded-3 overflow-hidden"></div>
            </div>
        </div>

        <div class="card">
            <div class="card-body" id="lastResult">
                <div class="empty-state"><i class="bi bi-qr-code-scan"></i>بانتظار أول عملية مسح</div>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="table-wrap">
            <div class="card-header">
                <h2>آخر عمليات التسجيل اليوم</h2>
                <span class="chip tone-info">@ViewHelpers.Date(Model.Date)</span>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0" id="recentTable">
                    <thead><tr><th>الطالب</th><th>الرقم</th><th>الشعبة</th><th>الحالة</th><th>الوقت</th></tr></thead>
                    <tbody>
                    @if (Model.Recent.Count == 0)
                    {
                        <tr id="emptyRow"><td colspan="5"><div class="empty-state"><i class="bi bi-clock-history"></i>لا توجد عمليات مسح اليوم</div></td></tr>
                    }
                    @foreach (var r in Model.Recent)
                    {
                        <tr>
                            <td class="fw-semibold">@r.Name</td>
                            <td class="num fs-sm">@r.Code</td>
                            <td class="text-muted-2 fs-sm">@r.Section</td>
                            <td>@r.Status.Badge()</td>
                            <td class="num fs-sm">@ViewHelpers.Time(r.Time)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/html5-qrcode/html5-qrcode.min.js"></script>
    <script>
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        let busy = false;
        let lastCode = '';
        let lastAt = 0;

        async function submitCode(code) {
            if (!code || busy) return;

            // منع التكرار السريع لنفس الرمز
            const now = Date.now();
            if (code === lastCode && now - lastAt < 3000) return;
            lastCode = code; lastAt = now;

            busy = true;
            try {
                const res = await fetch('@Url.Action("ScanRecord")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ code: code })
                });
                const data = await res.json();
                render(data);
                if (data.success) addRow(data);
            } catch (e) {
                render({ success: false, message: 'تعذّر الاتصال بالخادم.' });
            } finally {
                busy = false;
            }
        }

        function render(d) {
            const box = document.getElementById('lastResult');
            if (!d.success) {
                box.innerHTML =
                    '<div class="text-center py-3">' +
                    '<div class="mx-auto mb-2 tone-danger" style="width:60px;height:60px;border-radius:18px;display:grid;place-items:center;font-size:1.7rem"><i class="bi bi-x-circle-fill"></i></div>' +
                    '<div class="fw-bold">' + (d.message || 'فشل التسجيل') + '</div></div>';
                return;
            }
            box.innerHTML =
                '<div class="text-center py-2">' +
                '<div class="mx-auto mb-2 tone-ok" style="width:60px;height:60px;border-radius:18px;display:grid;place-items:center;font-size:1.7rem"><i class="bi bi-check-circle-fill"></i></div>' +
                '<div class="fw-bold" style="font-size:1.05rem">' + d.name + '</div>' +
                '<div class="fs-sm text-muted-2 num">' + d.code + ' · ' + d.section + '</div>' +
                '<div class="mt-2"><span class="chip tone-brand">' + d.status + '</span> ' +
                '<span class="chip tone-info num">' + d.time + '</span></div>' +
                '<div class="fs-sm text-success mt-2">' + d.message + '</div></div>';
        }

        function addRow(d) {
            document.getElementById('emptyRow')?.remove();
            const tbody = document.querySelector('#recentTable tbody');
            const tr = document.createElement('tr');
            tr.innerHTML =
                '<td class="fw-semibold">' + d.name + '</td>' +
                '<td class="num fs-sm">' + d.code + '</td>' +
                '<td class="text-muted-2 fs-sm">' + d.section + '</td>' +
                '<td><span class="chip tone-ok">' + d.status + '</span></td>' +
                '<td class="num fs-sm">' + d.time + '</td>';
            tbody.prepend(tr);
        }

        // إدخال يدوي / ماسح ضوئي بلوحة مفاتيح
        const manual = document.getElementById('manualCode');
        manual.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                submitCode(manual.value.trim());
                manual.value = '';
            }
        });

        // ============================ الكاميرا ============================
        let scanner = null;
        const btnStart = document.getElementById('startCam');
        const btnStop = document.getElementById('stopCam');
        const camMsg = document.getElementById('camMsg');
        const camPick = document.getElementById('camPick');
        const camPickWrap = document.getElementById('camPickWrap');

        function showMsg(tone, title, lines) {
            const icon = tone === 'danger' ? 'bi-exclamation-octagon-fill'
                : tone === 'warning' ? 'bi-exclamation-triangle-fill' : 'bi-info-circle-fill';
            camMsg.innerHTML =
                '<div class="alert alert-' + tone + ' mb-0 py-2 px-3">' +
                '<div class="fw-bold mb-1"><i class="bi ' + icon + ' me-1"></i>' + title + '</div>' +
                '<ul class="mb-0 ps-3 fs-sm">' + lines.map(l => '<li>' + l + '</li>').join('') + '</ul></div>';
        }
        function clearMsg() { camMsg.innerHTML = ''; }

        // ترجمة أخطاء getUserMedia إلى سبب وعلاج، فالنص الأصلي إنجليزي وغير مفهوم للمستخدم
        function explain(err) {
            const name = (err && (err.name || '')) + ' ' + (err && (err.message || err)) || '';

            if (/NotReadable|TrackStart|Could not start video source/i.test(name)) {
                return ['danger', 'الكاميرا مشغولة بتطبيق آخر', [
                    'أغلق أي برنامج يستخدم الكاميرا الآن: Teams أو Zoom أو تطبيق «الكاميرا» في ويندوز.',
                    'أغلق تبويبات المتصفح الأخرى التي فتحت الكاميرا من قبل.',
                    'إن بقيت المشكلة فافصل الكاميرا الخارجية وأعد وصلها، أو أعد تشغيل الجهاز.',
                    'حتى ذلك الحين استخدم حقل «رمز الطالب» أعلاه أو جهاز الماسح الضوئي — التسجيل يعمل بالكامل بدونها.'
                ]];
            }
            if (/NotAllowed|Permission|Dismissed/i.test(name)) {
                return ['warning', 'إذن الكاميرا مرفوض', [
                    'اضغط أيقونة القفل بجوار عنوان الصفحة ثم اسمح بالكاميرا وأعد تحميل الصفحة.',
                    'في ويندوز: الإعدادات ← الخصوصية والأمان ← الكاميرا، وفعّل وصول التطبيقات إليها.'
                ]];
            }
            if (/NotFound|DevicesNotFound|OverconstrainedError|no camera/i.test(name)) {
                return ['warning', 'لم يُعثر على كاميرا متصلة', [
                    'تأكد من توصيل الكاميرا وظهورها في «إدارة الأجهزة».',
                    'استخدم حقل «رمز الطالب» أو جهاز الماسح الضوئي بدلاً منها.'
                ]];
            }
            if (/SecurityError|insecure|getUserMedia is not/i.test(name) || !window.isSecureContext) {
                return ['warning', 'المتصفح يمنع الكاميرا على اتصال غير آمن', [
                    'المتصفحات تسمح بالكاميرا على https أو على localhost فقط.',
                    'إن كنت تفتح النظام من جهاز آخر عبر عنوان الشبكة، فافتحه عبر https.'
                ]];
            }
            return ['danger', 'تعذّر تشغيل الكاميرا', [
                'أعد تحميل الصفحة وحاول مجدداً.',
                'التفاصيل التقنية: ' + name.trim(),
                'يمكنك متابعة التسجيل من حقل «رمز الطالب» أو بجهاز الماسح الضوئي.'
            ]];
        }

        async function destroyScanner() {
            if (!scanner) return;
            try { await scanner.stop(); } catch (e) { /* لم تبدأ أصلاً */ }
            try { scanner.clear(); } catch (e) { }
            scanner = null;
        }

        function onScanned(text) { submitCode(text.trim()); }
        const scanCfg = { fps: 10, qrbox: { width: 240, height: 240 } };

        // محاولة التشغيل على كاميرا بعينها؛ ترجع الخطأ بدل رميه لنجرّب التالية
        async function tryStart(source) {
            scanner = new Html5Qrcode('reader');
            try {
                await scanner.start(source, scanCfg, onScanned, function () { });
                return null;
            } catch (err) {
                await destroyScanner();
                return err;
            }
        }

        btnStart.addEventListener('click', async function () {
            if (typeof Html5Qrcode === 'undefined') {
                showMsg('danger', 'مكتبة قراءة الرموز غير متاحة', ['أعد تحميل الصفحة؛ إن تكرّر الأمر فراجع مسؤول النظام.']);
                return;
            }

            clearMsg();
            btnStart.disabled = true;
            const label = btnStart.innerHTML;
            btnStart.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> جارٍ تشغيل الكاميرا...';

            try {
                // كاميرا اختارها المستخدم صراحةً
                let lastErr = null;
                if (camPick.value) {
                    lastErr = await tryStart({ deviceId: { exact: camPick.value } });
                } else {
                    // الكاميرا الخلفية أولاً، ثم بقية الكاميرات واحدة واحدة:
                    // NotReadableError كثيراً ما يخصّ كاميرا بعينها لا الجهاز كله
                    lastErr = await tryStart({ facingMode: 'environment' });

                    if (lastErr) {
                        let cams = [];
                        try { cams = await Html5Qrcode.getCameras(); } catch (e) { }

                        if (cams.length > 1) {
                            camPick.innerHTML = cams
                                .map(c => '<option value="' + c.id + '">' + (c.label || 'كاميرا') + '</option>').join('');
                            camPickWrap.classList.remove('d-none');
                        }

                        for (const cam of cams) {
                            lastErr = await tryStart({ deviceId: { exact: cam.id } });
                            if (!lastErr) { camPick.value = cam.id; break; }
                        }
                    }
                }

                if (lastErr) {
                    const [tone, title, lines] = explain(lastErr);
                    showMsg(tone, title, lines);
                    manual.focus();     // أعد المستخدم إلى الطريق الذي يعمل
                    return;
                }

                btnStart.classList.add('d-none');
                btnStop.classList.remove('d-none');
            } finally {
                btnStart.disabled = false;
                btnStart.innerHTML = label;
            }
        });

        camPick.addEventListener('change', function () {
            if (scanner) btnStop.click();
            btnStart.click();
        });

        btnStop.addEventListener('click', async function () {
            await destroyScanner();
            btnStart.classList.remove('d-none');
            btnStop.classList.add('d-none');
            clearMsg();
        });

        // تحرير الكاميرا عند مغادرة الصفحة حتى لا تبقى محجوزة لغيرها
        window.addEventListener('pagehide', function () { destroyScanner(); });
    </script>
}
