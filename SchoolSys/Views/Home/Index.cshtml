@* ==================== المراحل والفئات ==================== *@
<section class="sec sec-soft" id="stages">
    <div class="wrap">
        <div class="center reveal" style="margin-bottom:2.6rem">
            <div class="eyebrow"><i class="bi bi-layers-fill"></i> الفئات العمرية</div>
            <h2 class="sec-title">المراحل الدراسية التي نستقبلها</h2>
            <p class="sec-sub">
                نستقبل الطلاب عبر مراحل متدرّجة، لكل مرحلة منهج وأنشطة وأسلوب تقويم يناسب عمر الطالب.
            </p>
        </div>

        <div class="stage-grid">
            @{
                var stageIcons = new[] { "bi-balloon-heart-fill", "bi-backpack2-fill", "bi-mortarboard-fill", "bi-award-fill" };
                var stageTones = new[] { "ic-teal", "ic-blue", "ic-purple", "ic-amber" };
                var stageDesc = new[]
                {
                    "بناء الأساس: القراءة والكتابة والحساب عبر اللعب والاكتشاف، مع تنمية المهارات الحركية والاجتماعية.",
                    "ترسيخ المهارات: تعمّق في العلوم واللغات وبداية التفكير النقدي والمشاريع الجماعية.",
                    "التخصص والإعداد: مسارات علمية وأدبية وإعداد مكثّف لاختبارات الشهادة العامة والجامعة.",
                    "برامج متقدمة وإثرائية للطلاب المتميزين."
                };
                var i = 0;
            }

            @if (Model.Stages.Count == 0)
            {
                <div class="stage-card reveal">
                    <div class="top-bar"></div>
                    <div class="stage-illu"><i class="bi bi-layers" style="font-size:3rem;color:var(--l-mute)"></i></div>
                    <h3>لم تُضف المراحل بعد</h3>
                    <div class="range">سيتم عرض المراحل هنا فور إضافتها من لوحة التحكم.</div>
                </div>
            }

            @foreach (var st in Model.Stages)
            {
                var idx = Math.Min(i, stageIcons.Length - 1);
                <div class="stage-card reveal d@(Math.Min(i + 1, 4))">
                    <div class="top-bar"></div>
                    <div class="stage-illu">
                        <div class="@stageTones[idx] a-float-s"
                             style="width:78px;height:78px;border-radius:24px;display:grid;place-items:center;font-size:2.2rem">
                            <i class="bi @stageIcons[idx]"></i>
                        </div>
                    </div>
                    <h3>@st.Name</h3>
                    <div class="range">@stageDesc[idx]</div>
                    <div class="stage-meta">
                        <span class="pill pill-age"><i class="bi bi-person-standing"></i> @st.AgeLabel</span>
                        <span class="pill">@st.GradesCount صفوف</span>
                        <span class="pill">@st.StudentsCount.ToString("N0") طالب</span>
                    </div>
                    @if (!string.IsNullOrEmpty(st.GradeRange))
                    {
                        <div class="fs-xs" style="color:var(--l-mute);font-size:.78rem;margin-top:.7rem">
                            <i class="bi bi-bookmark"></i> @st.GradeRange
                        </div>
                    }
                </div>
                i++;
            }
        </div>
    </div>
</section>

@* ==================== الشهادات والبرامج ==================== *@
<section class="sec" id="programs">
    <div class="wrap">
        <div class="center reveal" style="margin-bottom:2.6rem">
            <div class="eyebrow"><i class="bi bi-patch-check-fill"></i> الشهادات والبرامج</div>
            <h2 class="sec-title">ماذا تقدّم المدرسة؟</h2>
            <p class="sec-sub">
                مسارات تعليمية معتمدة وبرامج إثرائية تُصدر لها شهادات موثّقة من المدرسة،
                ترافق الطالب في ملفه الأكاديمي.
