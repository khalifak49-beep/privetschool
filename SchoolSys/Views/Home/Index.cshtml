            <svg viewBox="0 0 560 460" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="رسمة مدرسة">
                <defs>
                    <linearGradient id="gSky" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0" stop-color="#1e4fa3" stop-opacity=".55" />
                        <stop offset="1" stop-color="#0b1f4b" stop-opacity="0" />
                    </linearGradient>
                    <linearGradient id="gWall" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0" stop-color="#ffffff" />
                        <stop offset="1" stop-color="#dbe6f8" />
                    </linearGradient>
                    <linearGradient id="gRoof" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0" stop-color="#0f9d8f" />
                        <stop offset="1" stop-color="#14b8a6" />
                    </linearGradient>
                    <linearGradient id="gDoor" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0" stop-color="#f59e0b" />
                        <stop offset="1" stop-color="#f97316" />
                    </linearGradient>
                    <linearGradient id="gBus" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0" stop-color="#fbbf24" />
                        <stop offset="1" stop-color="#f59e0b" />
                    </linearGradient>
                </defs>

                <!-- هالة الخلفية -->
                <circle cx="290" cy="215" r="200" fill="url(#gSky)" />
                <circle cx="290" cy="215" r="200" fill="none" stroke="rgba(255,255,255,.09)" stroke-width="1.5" class="a-pulse" />

                <!-- الشمس -->
                <g class="a-spin" style="transform-origin:470px 78px">
                    <g stroke="#fbbf24" stroke-width="4" stroke-linecap="round" opacity=".85">
                        <line x1="470" y1="34" x2="470" y2="48" />
                        <line x1="470" y1="108" x2="470" y2="122" />
                        <line x1="426" y1="78" x2="440" y2="78" />
                        <line x1="500" y1="78" x2="514" y2="78" />
                        <line x1="439" y1="47" x2="449" y2="57" />
                        <line x1="491" y1="99" x2="501" y2="109" />
                        <line x1="491" y1="57" x2="501" y2="47" />
                        <line x1="439" y1="109" x2="449" y2="99" />
                    </g>
                </g>
                <circle cx="470" cy="78" r="21" fill="#fbbf24" opacity=".95" />
                <circle cx="470" cy="78" r="30" fill="#fbbf24" opacity=".16" class="a-pulse" />

                <!-- سحب -->
