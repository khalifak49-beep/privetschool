                <rect x="202" y="262" width="20" height="20" rx="4" fill="#3159b8" opacity=".6" />
                <rect x="230" y="262" width="20" height="20" rx="4" fill="#3159b8" opacity=".6" />
                <rect x="202" y="296" width="20" height="20" rx="4" fill="#3159b8" opacity=".35" />
                <rect x="230" y="296" width="20" height="20" rx="4" fill="#3159b8" opacity=".6" />
                <path d="M180 240 L225 208 L270 240 Z" fill="url(#gRoof)" />

                <!-- المبنى: الجناح الأيسر -->
                <rect x="330" y="240" width="78" height="112" rx="10" fill="url(#gWall)" />
                <rect x="346" y="262" width="20" height="20" rx="4" fill="#3159b8" opacity=".6" />
                <rect x="374" y="262" width="20" height="20" rx="4" fill="#3159b8" opacity=".35" />
                <rect x="346" y="296" width="20" height="20" rx="4" fill="#3159b8" opacity=".6" />
                <rect x="374" y="296" width="20" height="20" rx="4" fill="#3159b8" opacity=".6" />
