@model LandingViewModel
@{
    Layout = null;
    var signedIn = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0b1f4b" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <title>@Model.SchoolName — مدرسة أهلية للتعليم الحديث</title>
    <meta name="description" content="@Model.SchoolName — تعليم نوعي من الروضة حتى الثانوية، بيئة تعلّم حديثة وأنشطة إثرائية ومتابعة رقمية لأولياء الأمور." />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
</head>
<body class="landing">

@* ==================== الشريط العلوي ==================== *@
<nav class="nav" id="siteNav">
    <div class="wrap nav-in">
        <a class="brand" href="#top">
            <div class="brand-mark">
                @if (!string.IsNullOrEmpty(Model.LogoPath))
                {
                    <img src="@Model.LogoPath" alt="" style="width:100%;height:100%;object-fit:contain;border-radius:13px" />
                }
                else
                {
                    <i class="bi bi-mortarboard-fill"></i>
                }
            </div>
            <div>
                <b>@Model.SchoolName</b>
                <span>@(Model.SchoolNameEn ?? "نظام تعليمي متكامل")</span>
            </div>
        </a>

        <button class="nav-toggle" id="navToggle" aria-label="القائمة"><i class="bi bi-list"></i></button>

        <div class="nav-links" id="navLinks">
            <a href="#about">عن المدرسة</a>
            <a href="#stages">المراحل</a>
            <a href="#programs">الشهادات والبرامج</a>
            <a href="#activities">الأنشطة</a>
            <a href="#why">لماذا نحن</a>
            <a href="#contact">تواصل معنا</a>
        </div>

        <div class="nav-cta">
            @if (signedIn)
            {
                <a class="btn-l btn-teal" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-speedometer2"></i> لوحة التحكم
                </a>
            }
            else
            {
                <a class="btn-l btn-teal" asp-controller="Account" asp-action="Login">
                    <i class="bi bi-box-arrow-in-left"></i> تسجيل الدخول
                </a>
            }
        </div>
    </div>
</nav>

@* ==================== البطل ==================== *@
<header class="hero" id="top">
    <div class="wrap hero-grid">
        <div>
            <div class="eyebrow"><i class="bi bi-stars"></i> العام الدراسي @(Model.YearName ?? "الجديد")</div>

            <h1>
                نُنشئ جيلاً يفكّر ويبدع<br />
                في بيئة <span class="grad">تعليمية حديثة</span>
            </h1>

            <p class="lead">
                @Model.SchoolName مدرسة أهلية تجمع بين المنهج الوطني والمهارات العالمية،
                بكادر مؤهل وفصول ذكية وأنشطة إثرائية، مع بوابة رقمية تتيح لولي الأمر
                متابعة أبنائه أولاً بأول.
            </p>

            <div class="hero-cta">
                <a class="btn-l btn-teal btn-lg-l" href="#programs">
                    <i class="bi bi-patch-check-fill"></i> برامجنا وشهاداتنا
                </a>
                <a class="btn-l btn-ghost btn-lg-l" href="#contact">
                    <i class="bi bi-telephone-fill"></i> احجز زيارة
                </a>
            </div>

            <div class="hero-badges">
                <div class="hero-badge"><i class="bi bi-check-circle-fill"></i> فصول لا تتجاوز 30 طالباً</div>
                <div class="hero-badge"><i class="bi bi-check-circle-fill"></i> نقل مدرسي آمن</div>
                <div class="hero-badge"><i class="bi bi-check-circle-fill"></i> متابعة رقمية لحظية</div>
            </div>
        </div>

        @* ---------- رسمة المدرسة المتحركة ---------- *@
