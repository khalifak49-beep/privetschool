                    <rect x="62" y="60" width="266" height="150" rx="12" fill="none" stroke="#0b1f4b" stroke-opacity=".18" stroke-width="2" />

                    <!-- كتابة على السبورة تُرسم تدريجياً -->
                    <path d="M96 108 h94" stroke="#7dd3fc" stroke-width="5" stroke-linecap="round" class="a-dash" />
                    <path d="M96 132 h150" stroke="#fff" stroke-width="4" stroke-linecap="round" opacity=".75" class="a-dash" style="animation-delay:.5s" />
                    <path d="M96 154 h112" stroke="#fff" stroke-width="4" stroke-linecap="round" opacity=".45" class="a-dash" style="animation-delay:1s" />
                    <path d="M96 176 h72" stroke="#4fd1c5" stroke-width="4" stroke-linecap="round" class="a-dash" style="animation-delay:1.4s" />

                    <!-- معادلة صغيرة تنبض -->
                    <g class="a-pulse" style="transform-origin:288px 92px">
                        <circle cx="288" cy="92" r="17" fill="#fbbf24" opacity=".25" />
                        <text x="288" y="98" text-anchor="middle" font-size="16" font-weight="700" fill="#fbbf24">%</text>
                    </g>

                    <!-- المعلمة -->
                    <g class="a-float-s">
                        <circle cx="392" cy="106" r="21" fill="#f59e0b" />
