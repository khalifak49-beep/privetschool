                <path d="M244 196 L297 152 L350 196 Z" fill="url(#gRoof)" />
                <rect x="290" y="130" width="14" height="30" rx="4" fill="#0b7d72" />

                <!-- الساعة -->
                <circle cx="297" cy="216" r="17" fill="#0b1f4b" opacity=".9" />
                <circle cx="297" cy="216" r="14" fill="#fff" />
                <g class="a-spin-f" style="transform-origin:297px 216px">
                    <line x1="297" y1="216" x2="297" y2="207" stroke="#0b1f4b" stroke-width="2.4" stroke-linecap="round" />
                </g>
                <line x1="297" y1="216" x2="304" y2="216" stroke="#0f9d8f" stroke-width="2" stroke-linecap="round" />
