                            <stop offset="1" stop-color="#134e4a" />
                        </linearGradient>
                        <linearGradient id="gCard" x1="0" y1="0" x2="1" y2="1">
                            <stop offset="0" stop-color="#f4f7fd" />
                            <stop offset="1" stop-color="#e2e9f7" />
                        </linearGradient>
                    </defs>

                    <rect x="20" y="24" width="480" height="330" rx="26" fill="url(#gCard)" />

                    <!-- السبورة -->
