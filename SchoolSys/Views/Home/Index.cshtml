                            <circle cx="259" cy="228" r="1.9" fill="#fff" />
                            <rect x="240" y="245" width="28" height="6" rx="3" fill="#0ea5e9" opacity=".55" />
                        </g>
                        <g class="a-float-s" style="animation-delay:.9s">
                            <circle cx="302" cy="228" r="15" fill="#f97316" />
                            <circle cx="297" cy="228" r="1.9" fill="#fff" />
                            <circle cx="307" cy="228" r="1.9" fill="#fff" />
                            <rect x="288" y="245" width="28" height="6" rx="3" fill="#f97316" opacity=".55" />
                        </g>
                    </g>

