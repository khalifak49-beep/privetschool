                            <rect x="140" y="245" width="28" height="6" rx="3" fill="#ec4899" opacity=".55" />
                        </g>
                    </g>

                    <g>
                        <rect x="222" y="248" width="112" height="12" rx="6" fill="#3159b8" opacity=".85" />
                        <rect x="236" y="260" width="8" height="34" rx="4" fill="#8fa3cc" />
                        <rect x="312" y="260" width="8" height="34" rx="4" fill="#8fa3cc" />
                        <g class="a-float-s" style="animation-delay:.3s">
                            <circle cx="254" cy="228" r="15" fill="#0ea5e9" />
