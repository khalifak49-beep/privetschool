                            <rect x="186" y="52" width="28" height="52" rx="14" fill="#fff" opacity=".95" />
                            <rect x="192" y="60" width="16" height="4" rx="2" fill="#b45309" opacity=".45" />
                            <rect x="192" y="70" width="16" height="4" rx="2" fill="#b45309" opacity=".45" />
                            <rect x="192" y="80" width="16" height="4" rx="2" fill="#b45309" opacity=".45" />
                            <path d="M172 94 a28 28 0 0 0 56 0" stroke="#fff" stroke-width="4" fill="none" stroke-linecap="round" />
                            <rect x="196" y="122" width="8" height="26" rx="4" fill="#fff" opacity=".9" />
                            <rect x="182" y="148" width="36" height="8" rx="4" fill="#fff" opacity=".9" />
                        </g>
                        <!-- نوتات طائرة -->
                        <g fill="#fff" opacity=".95">
                            <g class="a-note">
                                <circle cx="120" cy="120" r="8" />
                                <rect x="126" y="90" width="3.4" height="32" rx="1.7" />
                                <path d="M129 90 q12 5 12 14 q-4 -8 -12 -8 z" />
                            </g>
                            <g class="a-note n2">
                                <circle cx="272" cy="128" r="7" />
                                <rect x="277" y="102" width="3.2" height="28" rx="1.6" />
                                <path d="M280 102 q10 4 10 12 q-3 -7 -10 -7 z" />
                            </g>
                            <g class="a-note n3">
                                <circle cx="96" cy="70" r="6" />
                                <rect x="100" y="48" width="3" height="24" rx="1.5" />
                                <path d="M103 48 q9 4 9 11 q-3 -6 -9 -6 z" />
                            </g>
                        </g>
                        <!-- موجات صوت -->
                        <g stroke="#fff" stroke-width="3" stroke-linecap="round" opacity=".55">
                            <path d="M312 84 q12 16 0 32" fill="none" class="a-pulse" />
                            <path d="M328 74 q20 26 0 52" fill="none" class="a-pulse" style="animation-delay:.4s" />
                            <path d="M88 84 q-12 16 0 32" fill="none" class="a-pulse" style="animation-delay:.2s" />
                        </g>
                    </svg>
                </div>
                <div class="act-body">
                    <h3>الإنشاد والمسرح</h3>
                    <p>فرقة إنشاد وعروض مسرحية في المناسبات الوطنية والحفل السنوي.</p>
                </div>
            </div>

            @* ---------- المكتبة ---------- *@
            <div class="act-card reveal d2">
                <div class="act-scene" style="background:linear-gradient(135deg,#1b3a80,#0ea5e9)">
                    <span class="act-tag"><i class="bi bi-book"></i> قراءة</span>
                    <svg viewBox="0 0 400 200" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="مكتبة وقراءة">
                        <circle cx="200" cy="104" r="74" fill="#fff" opacity=".07" class="a-pulse" />
                        <!-- كتاب مفتوح -->
                        <g class="a-float-s">
                            <path d="M200 78 q-30 -18 -66 -12 v82 q36 -6 66 12 z" fill="#fff" opacity=".96" />
                            <path d="M200 78 q30 -18 66 -12 v82 q-36 -6 -66 12 z" fill="#e2e9f7" opacity=".96" />
                            <rect x="196" y="76" width="8" height="84" rx="4" fill="#1b3a80" opacity=".85" />
                            <g stroke="#3159b8" stroke-width="2.6" stroke-linecap="round" opacity=".45">
                                <path d="M148 96 h38" /><path d="M148 110 h38" /><path d="M148 124 h30" />
                                <path d="M214 96 h38" /><path d="M214 110 h38" /><path d="M214 124 h30" />
                            </g>
                        </g>
                        <!-- كتب متراصة -->
                        <g class="a-float-s" style="animation-delay:.7s">
                            <rect x="76" y="120" width="14" height="48" rx="4" fill="#fbbf24" />
                            <rect x="93" y="108" width="14" height="60" rx="4" fill="#4fd1c5" />
                            <rect x="110" y="126" width="14" height="42" rx="4" fill="#f472b6" />
                        </g>
                        <g class="a-float-s" style="animation-delay:1.1s">
                            <rect x="288" y="112" width="14" height="56" rx="4" fill="#f97316" />
                            <rect x="305" y="126" width="14" height="42" rx="4" fill="#a78bfa" />
                            <rect x="322" y="118" width="14" height="50" rx="4" fill="#4fd1c5" />
                        </g>
                        <!-- مصباح فكرة -->
                        <g class="a-float" style="animation-delay:.4s">
                            <path d="M200 30 a15 15 0 0 1 8 27 v5 h-16 v-5 a15 15 0 0 1 8 -27 z" fill="#fbbf24" />
                            <rect x="194" y="64" width="12" height="4" rx="2" fill="#f59e0b" />
                        </g>
                        <rect x="70" y="172" width="260" height="6" rx="3" fill="#fff" opacity=".2" />
                    </svg>
                </div>
                <div class="act-body">
                    <h3>المكتبة ومسابقات القراءة</h3>
                    <p>مكتبة غنية ومسابقة «القارئ المتميز» لتعزيز حب المطالعة لدى الطلاب.</p>
                </div>
            </div>
        </div>
    </div>
</section>

@* ==================== شريط متحرك ==================== *@
<div class="ticker">
    <div class="ticker-track">
        @for (var rep = 0; rep < 2; rep++)
        {
            <span class="ticker-item"><i class="bi bi-flag-fill"></i> اليوم الوطني</span>
            <span class="dot"></span>
            <span class="ticker-item"><i class="bi bi-easel-fill"></i> معرض العلوم</span>
            <span class="dot"></span>
            <span class="ticker-item"><i class="bi bi-tree-fill"></i> الرحلات التعليمية</span>
            <span class="dot"></span>
            <span class="ticker-item"><i class="bi bi-heart-pulse-fill"></i> اليوم الصحي</span>
            <span class="dot"></span>
            <span class="ticker-item"><i class="bi bi-book-half"></i> أسبوع القراءة</span>
            <span class="dot"></span>
            <span class="ticker-item"><i class="bi bi-cpu-fill"></i> مسابقة الروبوت</span>
            <span class="dot"></span>
            <span class="ticker-item"><i class="bi bi-trophy-fill"></i> البطولة الرياضية</span>
            <span class="dot"></span>
            <span class="ticker-item"><i class="bi bi-mic-fill"></i> الحفل السنوي</span>
            <span class="dot"></span>
        }
    </div>
</div>

@* ==================== لماذا نحن ==================== *@
<section class="sec" id="why">
    <div class="wrap">
        <div class="center reveal" style="margin-bottom:2.6rem">
            <div class="eyebrow"><i class="bi bi-hand-thumbs-up-fill"></i> لماذا نحن</div>
            <h2 class="sec-title">ما الذي يميّز تجربتنا التعليمية؟</h2>
        </div>

        <div class="feat-grid">
            <div class="feat reveal">
                <div class="feat-ic ic-teal"><i class="bi bi-people-fill"></i></div>
                <h3>فصول بأعداد مدروسة</h3>
                <p>لا يتجاوز الفصل 30 طالباً ليحصل كل طالب على اهتمام حقيقي من معلمه.</p>
            </div>
            <div class="feat reveal d1">
                <div class="feat-ic ic-blue"><i class="bi bi-phone-fill"></i></div>
                <h3>بوابة ولي الأمر</h3>
                <p>تابع الحضور والدرجات والواجبات والرسوم من حسابك في أي وقت.</p>
            </div>
            <div class="feat reveal d2">
                <div class="feat-ic ic-amber"><i class="bi bi-qr-code-scan"></i></div>
                <h3>حضور ذكي بـ QR</h3>
                <p>تسجيل الحضور والانصراف إلكترونياً مع إشعار فوري لولي الأمر عند الغياب.</p>
            </div>
            <div class="feat reveal d3">
                <div class="feat-ic ic-coral"><i class="bi bi-bus-front-fill"></i></div>
                <h3>نقل مدرسي آمن</h3>
                <p>حافلات مجهّزة بمشرفات، وتنبيه لولي الأمر عند صعود ونزول الطالب.</p>
            </div>
            <div class="feat reveal">
                <div class="feat-ic ic-purple"><i class="bi bi-clipboard2-pulse-fill"></i></div>
                <h3>تقويم مستمر</h3>
                <p>متابعة دورية للمستوى الأكاديمي والسلوكي مع تقارير مفصّلة لكل فصل.</p>
            </div>
            <div class="feat reveal d1">
                <div class="feat-ic ic-pink"><i class="bi bi-shield-check"></i></div>
                <h3>بيئة آمنة</h3>
                <p>مبنى مؤمّن ومراقب وطاقم إشراف تربوي وممرضة على مدار اليوم الدراسي.</p>
            </div>
            <div class="feat reveal d2">
                <div class="feat-ic ic-sky"><i class="bi bi-cash-coin"></i></div>
                <h3>رسوم مرنة</h3>
                <p>تقسيط الرسوم على دفعات مريحة مع خصومات للإخوة والمتفوقين.</p>
            </div>
            <div class="feat reveal d3">
                <div class="feat-ic ic-rose"><i class="bi bi-chat-heart-fill"></i></div>
                <h3>تواصل دائم</h3>
                <p>قناة رسائل مباشرة بين المعلم وولي الأمر ولقاءات دورية على مدار العام.</p>
            </div>
        </div>
    </div>
</section>

@* ==================== اليوم الدراسي ==================== *@
<section class="sec sec-soft">
    <div class="wrap">
        <div class="row g-5 align-items-center">
            <div class="col-lg-5 reveal">
                <div class="eyebrow"><i class="bi bi-clock-fill"></i> اليوم الدراسي</div>
                <h2 class="sec-title">يوم متوازن بين العلم والنشاط</h2>
                <p class="sec-sub" style="margin-bottom:1.6rem">
                    يبدأ الدوام @ViewHelpers.Time(Model.StartTime) وينتهي @ViewHelpers.Time(Model.EndTime)،
                    موزّعاً بين الحصص الدراسية وفترات النشاط والراحة.
                </p>
                <a class="btn-l btn-navy btn-lg-l" href="#contact">
                    <i class="bi bi-calendar-check-fill"></i> احجز جولة في المدرسة
                </a>
            </div>

            <div class="col-lg-7 reveal d2">
                <div class="timeline">
                    <div class="tl-item">
                        <div class="tl-time">@ViewHelpers.Time(Model.StartTime)</div>
                        <h4>الطابور الصباحي</h4>
                        <p>تحية العلم والإذاعة المدرسية وكلمة الصباح.</p>
                    </div>
                    <div class="tl-item">
                        <div class="tl-time">الحصص 1 – 2</div>
                        <h4>المواد الأساسية</h4>
                        <p>اللغة العربية والرياضيات في أوقات الذروة الذهنية للطالب.</p>
                    </div>
                    <div class="tl-item">
                        <div class="tl-time">الفسحة الأولى</div>
                        <h4>راحة ووجبة</h4>
                        <p>مقصف صحي وإشراف تربوي في الساحات.</p>
                    </div>
                    <div class="tl-item">
                        <div class="tl-time">الحصص 3 – 5</div>
                        <h4>العلوم واللغات والتقنية</h4>
                        <p>حصص عملية في المختبر ومعمل الحاسب.</p>
                    </div>
                    <div class="tl-item">
                        <div class="tl-time">الحصة الأخيرة</div>
                        <h4>النشاط الإثرائي</h4>
                        <p>رياضة أو فنون أو تحفيظ حسب اختيار الطالب.</p>
                    </div>
                    <div class="tl-item">
                        <div class="tl-time">@ViewHelpers.Time(Model.EndTime)</div>
                        <h4>الانصراف</h4>
                        <p>تسليم منظّم للحافلات ولأولياء الأمور مع تسجيل إلكتروني.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@* ==================== دعوة للتسجيل ==================== *@
<section class="sec" id="contact">
    <div class="wrap">
        <div class="cta reveal">
            <h2>التسجيل مفتوح للعام الدراسي @(Model.YearName ?? "الجديد")</h2>
            <p>
                احجز مقعد ابنك الآن، أو تفضّل بزيارتنا للاطلاع على المرافق ولقاء الكادر التعليمي.
                فريق القبول جاهز للإجابة على كل استفساراتك.
            </p>
            <div class="btns">
                @if (!string.IsNullOrEmpty(Model.Phone))
                {
                    <a class="btn-l btn-white btn-lg-l" href="tel:@Model.Phone.Replace(" ", "")">
                        <i class="bi bi-telephone-fill"></i> @Model.Phone
                    </a>
                }
                @if (!string.IsNullOrEmpty(Model.Email))
                {
                    <a class="btn-l btn-ghost btn-lg-l" href="mailto:@Model.Email">
                        <i class="bi bi-envelope-fill"></i> راسلنا
                    </a>
                }
                <a class="btn-l btn-teal btn-lg-l" asp-controller="Account" asp-action="Login">
                    <i class="bi bi-box-arrow-in-left"></i> بوابة أولياء الأمور
                </a>
            </div>
        </div>
    </div>
</section>

@* ==================== التذييل ==================== *@
<footer class="foot">
    <div class="wrap">
        <div class="foot-grid">
            <div>
                <div class="brand" style="margin-bottom:.9rem">
                    <div class="brand-mark"><i class="bi bi-mortarboard-fill"></i></div>
                    <div>
                        <b style="color:#fff">@Model.SchoolName</b>
                        <span style="color:#7d8fb8">@(Model.SchoolNameEn ?? "")</span>
                    </div>
                </div>
                <p>
                    مدرسة أهلية تُقدّم تعليماً نوعياً في بيئة حديثة وآمنة،
                    مع نظام إدارة رقمي متكامل يربط الإدارة والمعلمين والطلاب وأولياء الأمور.
                </p>
            </div>

            <div>
                <h4>روابط سريعة</h4>
                <ul>
                    <li><a href="#about">عن المدرسة</a></li>
                    <li><a href="#stages">المراحل الدراسية</a></li>
                    <li><a href="#programs">الشهادات والبرامج</a></li>
                    <li><a href="#activities">الأنشطة</a></li>
                    <li><a href="#why">لماذا نحن</a></li>
                </ul>
            </div>

            <div>
                <h4>البوابات</h4>
                <ul>
                    <li><a asp-controller="Account" asp-action="Login">بوابة ولي الأمر</a></li>
                    <li><a asp-controller="Account" asp-action="Login">بوابة الطالب</a></li>
                    <li><a asp-controller="Account" asp-action="Login">بوابة المعلم</a></li>
                    <li><a asp-controller="Account" asp-action="Login">لوحة الإدارة</a></li>
                </ul>
            </div>

            <div>
                <h4>تواصل معنا</h4>
                <ul class="foot-contact">
                    @if (!string.IsNullOrEmpty(Model.Address))
                    {
                        <li><i class="bi bi-geo-alt-fill"></i><span>@Model.Address</span></li>
                    }
                    @if (!string.IsNullOrEmpty(Model.Phone))
                    {
                        <li><i class="bi bi-telephone-fill"></i><a href="tel:@Model.Phone.Replace(" ", "")" dir="ltr">@Model.Phone</a></li>
                    }
                    @if (!string.IsNullOrEmpty(Model.Email))
                    {
                        <li><i class="bi bi-envelope-fill"></i><a href="mailto:@Model.Email" dir="ltr">@Model.Email</a></li>
                    }
                    @if (!string.IsNullOrEmpty(Model.Website))
                    {
                        <li><i class="bi bi-globe2"></i><span dir="ltr">@Model.Website</span></li>
                    }
                    <li><i class="bi bi-clock-fill"></i><span>الدوام: @ViewHelpers.Time(Model.StartTime) — @ViewHelpers.Time(Model.EndTime)</span></li>
                </ul>
            </div>
        </div>

        <div class="foot-bottom">
            <div>© @DateTime.Today.Year @Model.SchoolName — جميع الحقوق محفوظة.</div>
            <div>نظام إدارة مدرسي متكامل</div>
        </div>
    </div>
</footer>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/landing.js" asp-append-version="true"></script>
</body>
</html>
