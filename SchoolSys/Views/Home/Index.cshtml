                    <rect x="102" y="206" width="36" height="4" rx="2" fill="#3159b8" opacity=".55" />
                    <rect x="102" y="216" width="26" height="4" rx="2" fill="#3159b8" opacity=".35" />
                    <rect x="102" y="226" width="32" height="4" rx="2" fill="#0f9d8f" opacity=".55" />
                </g>

                <g class="a-float-2">
                    <circle cx="432" cy="182" r="26" fill="#fff" opacity=".97" />
                    <circle cx="432" cy="182" r="5" fill="#7c3aed" />
                    <ellipse cx="432" cy="182" rx="20" ry="8" fill="none" stroke="#7c3aed" stroke-width="2.2" opacity=".8" />
                    <ellipse cx="432" cy="182" rx="20" ry="8" fill="none" stroke="#7c3aed" stroke-width="2.2" opacity=".8" transform="rotate(60 432 182)" />
                    <ellipse cx="432" cy="182" rx="20" ry="8" fill="none" stroke="#7c3aed" stroke-width="2.2" opacity=".8" transform="rotate(120 432 182)" />
                </g>

                <g class="a-float-3">
                    <circle cx="112" cy="278" r="23" fill="#fff" opacity=".97" />
                    <path d="M112 265 a11 11 0 0 1 6 20 v4 h-12 v-4 a11 11 0 0 1 6 -20 z" fill="#f59e0b" />
                    <rect x="107" y="291" width="10" height="3.4" rx="1.7" fill="#f59e0b" opacity=".65" />
                </g>

                <g class="a-float" style="animation-delay:1.2s">
                    <circle cx="466" cy="286" r="22" fill="#fff" opacity=".97" />
                    <path d="M457 292 L468 276 L475 288" stroke="#0f9d8f" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                    <circle cx="475" cy="288" r="3" fill="#0f9d8f" />
                    <path d="M455 296 h22" stroke="#0f9d8f" stroke-width="2.6" stroke-linecap="round" opacity=".45" />
                </g>
            </svg>
        </div>
    </div>
</header>

@* ==================== شريط الإحصاءات ==================== *@
<div class="wrap stats-bar">
    <div class="stats-in reveal">
        <div class="stat-i">
            <div class="ic ic-teal"><i class="bi bi-mortarboard-fill"></i></div>
            <div class="n" data-count="@Model.Students">0</div>
            <div class="t">طالب وطالبة</div>
        </div>
        <div class="stat-i">
            <div class="ic ic-blue"><i class="bi bi-person-badge-fill"></i></div>
            <div class="n" data-count="@Model.Teachers">0</div>
            <div class="t">معلم ومعلمة</div>
        </div>
        <div class="stat-i">
            <div class="ic ic-purple"><i class="bi bi-building-fill"></i></div>
            <div class="n" data-count="@Model.Sections">0</div>
            <div class="t">شعبة دراسية</div>
        </div>
        <div class="stat-i">
            <div class="ic ic-amber"><i class="bi bi-journal-bookmark-fill"></i></div>
            <div class="n" data-count="@Model.Subjects">0</div>
            <div class="t">مادة دراسية</div>
        </div>
        <div class="stat-i">
            <div class="ic ic-coral"><i class="bi bi-bus-front-fill"></i></div>
            <div class="n" data-count="@Model.Buses">0</div>
            <div class="t">حافلة مدرسية</div>
        </div>
    </div>
</div>

@* ==================== عن المدرسة ==================== *@
<section class="sec" id="about">
    <div class="wrap">
        <div class="row g-5 align-items-center">
            <div class="col-lg-6 reveal">
                <div class="eyebrow"><i class="bi bi-building-check"></i> من نحن</div>
                <h2 class="sec-title">مدرسة تُوازن بين الأصالة والمهارات الحديثة</h2>
                <p class="sec-sub" style="margin-bottom:1.4rem">
                    نقدّم تعليماً نوعياً يبدأ من الصفوف الأولى وحتى الثانوية العامة، ضمن بيئة
                    تربوية آمنة تُنمّي الشخصية والقيم إلى جانب التحصيل الأكاديمي. نعتمد على
                    التعلّم النشط والمشاريع التطبيقية بدل الحفظ، ونقيس تقدّم كل طالب بشكل مستمر.
                </p>

                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="feat">
                            <div class="feat-ic ic-teal"><i class="bi bi-bullseye"></i></div>
                            <h3>رسالتنا</h3>
                            <p>إعداد متعلّم واثق، متمكّن من لغته وهويته، وقادر على المنافسة عالمياً.</p>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="feat">
                            <div class="feat-ic ic-purple"><i class="bi bi-eye"></i></div>
                            <h3>رؤيتنا</h3>
                            <p>أن نكون خياراً تعليمياً أول للأسرة الباحثة عن جودة حقيقية ومتابعة شفافة.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 reveal d2">
                @* رسمة الفصل الدراسي المتحركة *@
                <svg viewBox="0 0 520 380" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="فصل دراسي">
                    <defs>
                        <linearGradient id="gBoard" x1="0" y1="0" x2="0" y2="1">
