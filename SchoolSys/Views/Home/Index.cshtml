                    <circle cx="154" cy="312" r="22" fill="#14b8a6" opacity=".92" />
                    <circle cx="140" cy="322" r="14" fill="#0f9d8f" opacity=".9" />
                    <circle cx="168" cy="322" r="14" fill="#0f9d8f" opacity=".9" />
                </g>
                <g class="a-swing" style="transform-origin:440px 352px;animation-delay:.9s">
                    <rect x="436" y="326" width="8" height="28" rx="4" fill="#8b5e3c" />
                    <circle cx="440" cy="318" r="19" fill="#14b8a6" opacity=".9" />
                    <circle cx="428" cy="326" r="12" fill="#0f9d8f" opacity=".85" />
                </g>

                <!-- الحافلة -->
                <g class="a-drift" style="animation-duration:16s">
                    <rect x="60" y="316" width="72" height="36" rx="9" fill="url(#gBus)" />
                    <rect x="66" y="324" width="17" height="14" rx="3" fill="#0b1f4b" opacity=".55" />
                    <rect x="88" y="324" width="17" height="14" rx="3" fill="#0b1f4b" opacity=".55" />
                    <rect x="110" y="324" width="16" height="14" rx="3" fill="#0b1f4b" opacity=".35" />
                    <circle cx="78" cy="354" r="8" fill="#0b1f4b" />
                    <circle cx="78" cy="354" r="3.4" fill="#8fa3cc" />
                    <circle cx="116" cy="354" r="8" fill="#0b1f4b" />
                    <circle cx="116" cy="354" r="3.4" fill="#8fa3cc" />
