@{
    ViewData["Title"] = "خطأ";
    Layout = "_Layout";
}

<div class="d-flex align-items-center justify-content-center" style="min-height:60vh">
    <div class="card text-center" style="max-width:520px">
        <div class="card-body p-5">
            <div class="mx-auto mb-3 tone-danger"
                 style="width:76px;height:76px;border-radius:22px;display:grid;place-items:center;font-size:2.1rem">
                <i class="bi bi-bug"></i>
            </div>
            <h1 class="fw-bold" style="font-size:1.4rem">حدث خطأ غير متوقع</h1>
            <p class="text-muted-2 mb-3">
                نعتذر عن هذا الخلل. تم تسجيل الخطأ وسيتم مراجعته من قِبل فريق الدعم.
            </p>
            @if (ViewBag.RequestId is string rid && !string.IsNullOrEmpty(rid))
            {
                <p class="fs-xs text-muted-3">رقم الطلب: <code>@rid</code></p>
            }
            <a class="btn btn-primary mt-2" asp-controller="Dashboard" asp-action="Index">
                <i class="bi bi-house me-1"></i> العودة للوحة التحكم
            </a>
        </div>
    </div>
</div>
