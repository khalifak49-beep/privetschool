@model SubscriptionIndexViewModel
@{
    ViewData["Title"] = "اشتراكات النقل";
    var canManage = User.Can(Permissions.TransportManage);
    var cur = Model.Currency;
}

<div class="page-head">
    <div>
        <h1>اشتراكات النقل المدرسي</h1>
        <p class="sub">
            @Model.TotalSubscribers مشترك ·
            إيراد شهري <b class="num">@Model.MonthlyRevenue.ToString("N2")</b> @cur
        </p>
    </div>
    @if (canManage)
    {
        <div class="actions">
            <button class="btn btn-primary" onclick="openSub()"><i class="bi bi-plus-lg me-1"></i> اشتراك جديد</button>
        </div>
    }
</div>

<div class="card mb-3">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label">بحث</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input name="q" value="@Model.Q" class="form-control" placeholder="اسم الطالب أو رقمه..." />
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label">خط السير</label>
                <select name="routeId" class="form-select form-select-sm" data-autosubmit>
                    <option value="">كل الخطوط</option>
                    @foreach (var r in Model.Routes)
                    {
                        <option value="@r.Value" selected="@r.Selected">@r.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-4 d-flex gap-1">
                <button class="btn btn-sm btn-primary"><i class="bi bi-funnel me-1"></i> بحث</button>
                <a asp-action="Subscriptions" class="btn btn-sm btn-light">مسح</a>
            </div>
        </form>
    </div>
</div>

<div class="table-wrap">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
            <tr>
                <th>الطالب</th>
                <th>الشعبة</th>
                <th>خط السير</th>
                <th>المحطة</th>
                <th>الحافلة</th>
                <th>الرسوم</th>
                <th>الحالة</th>
                <th style="width:90px"></th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Subscriptions.TotalCount == 0)
            {
                <tr><td colspan="8"><div class="empty-state"><i class="bi bi-person-vcard"></i>لا توجد اشتراكات</div></td></tr>
            }
            @foreach (var s in Model.Subscriptions.Items)
            {
                <tr>
                    <td>
                        <a asp-controller="Students" asp-action="Details" asp-route-id="@s.StudentId" class="fw-semibold text-reset">@s.StudentName</a>
                        <div class="fs-xs text-muted-3 num">@s.StudentNo</div>
                    </td>
                    <td class="fs-sm text-muted-2">@(s.Section ?? "—")</td>
                    <td class="fs-sm">@s.RouteName</td>
                    <td class="fs-sm text-muted-2">@(s.StopName ?? "—")</td>
                    <td class="fs-sm num">@(s.BusNo ?? "—")</td>
                    <td class="num">@s.MonthlyFee.ToString("N2")</td>
                    <td>
                        @if (s.IsActive)
                        {
                            <span class="chip tone-ok">نشط</span>
                        }
                        else
                        {
                            <span class="chip tone-danger">موقوف</span>
                        }
                    </td>
                    <td>
                        @if (canManage)
                        {
                            <div class="d-flex gap-1">
                                <button class="btn btn-sm btn-light"
                                        onclick='openSub(@Html.Raw(Json.Serialize(new { s.Id, s.StudentId, s.StudentName, s.RouteId, s.MonthlyFee, StartDate = s.StartDate.ToString("yyyy-MM-dd"), s.IsActive })))'>
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <form asp-action="DeleteSubscription" method="post">
                                    <input type="hidden" name="id" value="@s.Id" />
                                    <input type="hidden" name="routeId" value="@Model.RouteId" />
                                    <button class="btn btn-sm btn-light text-danger" data-confirm="إلغاء اشتراك هذا الطالب؟"><i class="bi bi-trash"></i></button>
                                </form>
                            </div>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="Model.Subscriptions" />
</div>

@if (canManage)
{
    <div class="modal fade" id="subModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content" asp-action="SaveSubscription" method="post">
                <input type="hidden" name="id" id="s-id" value="0" />
                <div class="modal-header">
                    <h5 class="modal-title">اشتراك نقل مدرسي</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3" id="studentPicker">
                        <label class="form-label">الطالب</label>
                        <input class="form-control" id="studentSearch" placeholder="ابحث بالاسم أو الرقم الطلابي..." autocomplete="off" />
                        <input type="hidden" name="studentId" id="studentId" required />
                        <div class="list-group mt-1" id="studentResults" style="max-height:190px;overflow:auto"></div>
                    </div>

                    <div class="row g-2">
                        <div class="col-12">
                            <label class="form-label">خط السير</label>
                            <select name="routeId" id="s-route" class="form-select" required>
                                <option value="">— اختر الخط —</option>
                                @foreach (var r in Model.Routes)
                                {
                                    <option value="@r.Value">@r.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">المحطة</label>
                            <select name="stopId" id="s-stop" class="form-select" asp-items="Model.Stops">
                                <option value="">— بدون —</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label">الرسوم الشهرية</label>
                            <input name="monthlyFee" id="s-fee" type="number" step="0.01" class="form-control num" value="0" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">تاريخ البداية</label>
                            <input name="startDate" id="s-start" type="date" class="form-control"
                                   value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>
                    <div class="form-check mt-3">
                        <input class="form-check-input" type="checkbox" name="isActive" value="true" id="s-active" checked />
                        <label class="form-check-label" for="s-active">اشتراك نشط</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary">حفظ</button>
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">إلغاء</button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <script>
        function openSub(d) {
            d = d || { Id: 0, StudentId: '', StudentName: '', RouteId: '', MonthlyFee: 0, StartDate: '@DateTime.Today.ToString("yyyy-MM-dd")', IsActive: true };
            document.getElementById('s-id').value = d.Id;
            document.getElementById('studentId').value = d.StudentId || '';
            document.getElementById('studentSearch').value = d.StudentName || '';
            document.getElementById('studentSearch').disabled = d.Id > 0;
            document.getElementById('s-route').value = d.RouteId || '';
            document.getElementById('s-fee').value = d.MonthlyFee || 0;
            document.getElementById('s-start').value = d.StartDate || '';
            document.getElementById('s-active').checked = !!d.IsActive;
            new bootstrap.Modal(document.getElementById('subModal')).show();
        }

        const search = document.getElementById('studentSearch');
        const results = document.getElementById('studentResults');
        const hidden = document.getElementById('studentId');
        let timer;

        search?.addEventListener('input', function () {
            clearTimeout(timer);
            hidden.value = '';
            const q = this.value.trim();
            if (q.length < 2) { results.innerHTML = ''; return; }

            timer = setTimeout(function () {
                fetch('@Url.Action("SearchStudents")?q=' + encodeURIComponent(q))
                    .then(r => r.json())
                    .then(items => {
                        results.innerHTML = items.length
                            ? items.map(i =>
                                '<button type="button" class="list-group-item list-group-item-action py-2" data-id="' + i.id + '">' +
                                '<div class="fw-semibold fs-sm">' + i.name + '</div>' +
                                '<div class="fs-xs text-muted-3">' + i.no + ' · ' + i.section + '</div></button>').join('')
                            : '<div class="text-muted-3 fs-sm p-2">لا توجد نتائج</div>';
                    });
            }, 250);
        });

        results?.addEventListener('click', function (e) {
            const btn = e.target.closest('[data-id]');
            if (!btn) return;
            hidden.value = btn.getAttribute('data-id');
            search.value = btn.querySelector('.fw-semibold').textContent;
            results.innerHTML = '';
        });
    </script>
}
