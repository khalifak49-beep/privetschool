@model TransportLogViewModel
@{
    ViewData["Title"] = "الصعود والنزول";
}

<div class="page-head">
    <div>
        <h1>تسجيل الصعود والنزول</h1>
        <p class="sub">
            @(Model.RouteName ?? "اختر خط سير") · @ViewHelpers.Date(Model.Date) · @Model.Direction.Display()
        </p>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label">خط السير</label>
                <select name="routeId" class="form-select form-select-sm" data-autosubmit>
                    <option value="">— اختر —</option>
                    @foreach (var r in Model.Routes)
                    {
                        <option value="@r.Value" selected="@r.Selected">@r.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">التاريخ</label>
                <input name="date" type="date" value="@Model.Date.ToString("yyyy-MM-dd")"
                       class="form-control form-control-sm" data-autosubmit />
            </div>
            <div class="col-md-3">
                <label class="form-label">الاتجاه</label>
                <select name="direction" class="form-select form-select-sm" data-autosubmit>
                    @foreach (var (v, t) in ViewHelpers.Options<TransportDirection>())
                    {
                        <option value="@((int)v)" selected="@(Model.Direction == v)">@t</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button class="btn btn-sm btn-primary w-100"><i class="bi bi-arrow-repeat me-1"></i> عرض</button>
            </div>
        </form>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-4">
        <div class="stat-card"><div class="ico tone-brand"><i class="bi bi-people"></i></div>
            <div><div class="value num">@Model.Students.Count</div><div class="label">المشتركون</div></div></div>
    </div>
    <div class="col-4">
        <div class="stat-card"><div class="ico tone-ok"><i class="bi bi-box-arrow-in-left"></i></div>
            <div><div class="value num" id="boardCnt">@Model.BoardedCount</div><div class="label">صعدوا</div></div></div>
    </div>
    <div class="col-4">
        <div class="stat-card"><div class="ico tone-info"><i class="bi bi-box-arrow-right"></i></div>
            <div><div class="value num" id="alightCnt">@Model.AlightedCount</div><div class="label">نزلوا</div></div></div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body py-2">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="notifyGuardian" checked />
            <label class="form-check-label fs-sm" for="notifyGuardian">
                <i class="bi bi-bell me-1"></i> إشعار ولي الأمر فور التسجيل
            </label>
        </div>
    </div>
</div>

<div class="table-wrap">
    <div class="card-header"><h2>قائمة الطلاب</h2></div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
            <tr>
                <th style="width:44px">#</th>
                <th>الطالب</th>
                <th>الشعبة</th>
                <th>المحطة</th>
                <th style="width:150px">الصعود</th>
                <th style="width:150px">النزول</th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Students.Count == 0)
            {
                <tr><td colspan="6"><div class="empty-state"><i class="bi bi-bus-front"></i>لا يوجد مشتركون في هذا الخط</div></td></tr>
            }
            @for (var i = 0; i < Model.Students.Count; i++)
            {
                var s = Model.Students[i];
                <tr>
                    <td class="num text-muted-3">@(i + 1)</td>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <div class="avatar sm">
                                @if (!string.IsNullOrEmpty(s.PhotoPath))
                                {
                                    <img src="@s.PhotoPath" alt="" />
                                }
                                else
                                {
                                    @ViewHelpers.Initials(s.StudentName)
                                }
                            </div>
                            <div class="min-w-0">
                                <div class="fw-semibold text-truncate">@s.StudentName</div>
                                <div class="fs-xs text-muted-3 num">@s.StudentNo</div>
                            </div>
                        </div>
                    </td>
                    <td class="fs-sm text-muted-2">@(s.Section ?? "—")</td>
                    <td class="fs-sm">@(s.StopName ?? "—")</td>
                    <td>
                        <button class="btn btn-sm w-100 evt-btn @(s.Boarded ? "btn-success" : "btn-outline-primary")"
                                data-student="@s.StudentId" data-event="1" id="board-@s.StudentId">
                            <i class="bi @(s.Boarded ? "bi-check-circle-fill" : "bi-box-arrow-in-left")"></i>
                            <span>@(s.Boarded ? ViewHelpers.Time(s.BoardTime) : "تسجيل صعود")</span>
                        </button>
                    </td>
                    <td>
                        <button class="btn btn-sm w-100 evt-btn @(s.Alighted ? "btn-info text-white" : "btn-outline-primary")"
                                data-student="@s.StudentId" data-event="2" id="alight-@s.StudentId">
                            <i class="bi @(s.Alighted ? "bi-check-circle-fill" : "bi-box-arrow-right")"></i>
                            <span>@(s.Alighted ? ViewHelpers.Time(s.AlightTime) : "تسجيل نزول")</span>
                        </button>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        const routeId = @(Model.RouteId ?? 0);
        const date = '@Model.Date.ToString("yyyy-MM-dd")';
        const direction = @((int)Model.Direction);

        document.querySelectorAll('.evt-btn').forEach(function (btn) {
            btn.addEventListener('click', async function () {
                const studentId = parseInt(btn.getAttribute('data-student'), 10);
                const eventType = parseInt(btn.getAttribute('data-event'), 10);
                btn.disabled = true;

                try {
                    const res = await fetch('@Url.Action("RecordEvent")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            studentId: studentId,
                            routeId: routeId,
                            date: date,
                            eventType: eventType,
                            direction: direction,
                            notifyGuardian: document.getElementById('notifyGuardian').checked
                        })
                    });
                    const data = await res.json();

                    if (!data.success) {
                        window.showToast(data.message, 'danger');
                        return;
                    }

                    const isBoard = eventType === 1;
                    const onClass = isBoard ? 'btn-success' : 'btn-info text-white';
                    const icon = btn.querySelector('i');
                    const label = btn.querySelector('span');

                    if (data.recorded) {
                        btn.className = 'btn btn-sm w-100 evt-btn ' + onClass;
                        icon.className = 'bi bi-check-circle-fill';
                        label.textContent = data.time;
                    } else {
                        btn.className = 'btn btn-sm w-100 evt-btn btn-outline-primary';
                        icon.className = isBoard ? 'bi bi-box-arrow-in-left' : 'bi bi-box-arrow-right';
                        label.textContent = isBoard ? 'تسجيل صعود' : 'تسجيل نزول';
                    }

                    recount();
                } catch (e) {
                    window.showToast('تعذّر الاتصال بالخادم.', 'danger');
                } finally {
                    btn.disabled = false;
                }
            });
        });

        function recount() {
            let b = 0, a = 0;
            document.querySelectorAll('.evt-btn').forEach(function (el) {
                const done = el.querySelector('i').classList.contains('bi-check-circle-fill');
                if (!done) return;
                if (el.getAttribute('data-event') === '1') b++; else a++;
            });
            document.getElementById('boardCnt').textContent = b;
            document.getElementById('alightCnt').textContent = a;
        }
    </script>
}
