@{
    ViewData["Title"] = "غير مصرح بالوصول";
}

<div class="d-flex align-items-center justify-content-center" style="min-height:60vh">
    <div class="card text-center" style="max-width:480px">
        <div class="card-body p-5">
            <div class="mx-auto mb-3 d-grid place-items-center tone-danger"
                 style="width:76px;height:76px;border-radius:22px;display:grid;place-items:center;font-size:2.1rem">
                <i class="bi bi-shield-exclamation"></i>
            </div>
            <h1 class="fw-bold" style="font-size:1.4rem">غير مصرح لك بالوصول</h1>
            <p class="text-muted-2 mb-4">
                ليس لديك الصلاحية اللازمة لعرض هذه الصفحة.
                إذا كنت تعتقد أن هذا خطأ، يرجى التواصل مع مسؤول النظام.
            </p>
            <div class="d-flex gap-2 justify-content-center">
                <a class="btn btn-primary" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-house me-1"></i> العودة للوحة التحكم
                </a>
                <a class="btn btn-light" href="javascript:history.back()">رجوع</a>
            </div>
        </div>
    </div>
</div>
