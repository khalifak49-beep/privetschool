@model OverdueViewModel
@{
    ViewData["Title"] = "الرسوم المتأخرة";
    var cur = Model.Currency;
}

<div class="page-head">
    <div>
        <h1>الرسوم المتأخرة</h1>
        <p class="sub">
            <span class="chip tone-danger num">@Model.TotalOverdue.ToString("N2") @cur</span>
            على @Model.StudentCount طالب · @Model.Rows.Count قسط متأخر
        </p>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label">الشعبة</label>
                <select name="sectionId" class="form-select form-select-sm" data-autosubmit>
                    <option value="">كل الشعب</option>
                    @foreach (var s in Model.Sections)
                    {
                        <option value="@s.Value" selected="@s.Selected">@s.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">متأخر أكثر من (يوم)</label>
                <select name="minDaysOverdue" class="form-select form-select-sm" data-autosubmit>
                    @foreach (var d in new[] { 0, 7, 15, 30, 60, 90 })
                    {
                        <option value="@d" selected="@(Model.MinDaysOverdue == d)">@(d == 0 ? "الكل" : $"{d} يوم")</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <button class="btn btn-sm btn-primary"><i class="bi bi-funnel me-1"></i> تصفية</button>
            </div>
        </form>
    </div>
</div>

<form asp-action="SendReminders" method="post">
    <input type="hidden" name="sectionId" value="@Model.SectionId" />

    <div class="table-wrap">
        <div class="card-header">
            <h2>الأقساط المتأخرة</h2>
            @if (User.Can(Permissions.NotificationsSend) && Model.Rows.Count > 0)
            {
                <button type="submit" class="btn btn-sm btn-accent"
                        data-confirm="سيتم إرسال تنبيه لأولياء أمور الأقساط المحددة. متابعة؟">
                    <i class="bi bi-send me-1"></i> إرسال تنبيهات للمحدد
                </button>
            }
        </div>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                <tr>
                    <th style="width:40px">
                        <input type="checkbox" class="form-check-input" data-check-all=".inst-check"
                               aria-label="تحديد كل الأقساط" />
                    </th>
                    <th>الطالب</th>
                    <th>الشعبة</th>
                    <th>القسط</th>
                    <th>الاستحقاق</th>
                    <th>المتبقي</th>
                    <th>جوال ولي الأمر</th>
                    <th>التنبيه</th>
                    <th style="width:60px"></th>
                </tr>
                </thead>
                <tbody>
                @if (Model.Rows.Count == 0)
                {
                    <tr><td colspan="9"><div class="empty-state"><i class="bi bi-emoji-smile"></i>لا توجد أقساط متأخرة 🎉</div></td></tr>
                }
                @foreach (var r in Model.Rows)
                {
                    <tr>
                        <td>
                            <input type="checkbox" class="form-check-input inst-check" name="installmentIds"
                                   value="@r.InstallmentId"
                                   aria-label="تحديد قسط @r.Name للطالب @r.StudentName" />
                        </td>
                        <td>
                            <a asp-controller="Students" asp-action="Details" asp-route-id="@r.StudentId" class="fw-semibold text-reset">@r.StudentName</a>
                            <div class="fs-xs text-muted-3 num">@r.StudentNo</div>
                        </td>
                        <td class="fs-sm text-muted-2">@(r.Section ?? "—")</td>
                        <td class="fs-sm">@r.Name</td>
                        <td>
                            <div class="num fs-sm">@ViewHelpers.Date(r.DueDate)</div>
                            <span class="chip @(r.DaysOverdue > 60 ? "tone-danger" : r.DaysOverdue > 30 ? "tone-warn" : "tone-info")">
                                متأخر @r.DaysOverdue يوم
                            </span>
                        </td>
                        <td class="num fw-bold text-danger">@r.Remaining.ToString("N2")</td>
                        <td class="num fs-sm" dir="ltr">@(r.GuardianPhone ?? "—")</td>
                        <td>
                            @if (r.ReminderSent)
                            {
                                <span class="chip tone-ok"><i class="bi bi-check2"></i>أُرسل</span>
                            }
                            else
                            {
                                <span class="chip tone-warn">لم يُرسل</span>
                            }
                        </td>
                        <td>
                            <a class="btn btn-sm btn-light" asp-action="InvoiceDetails" asp-route-id="@r.InvoiceId" title="الفاتورة">
                                <i class="bi bi-receipt"></i>
                            </a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</form>
