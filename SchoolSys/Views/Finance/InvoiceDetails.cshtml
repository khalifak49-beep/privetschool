@model InvoiceDetailsViewModel
@{
    var inv = Model.Invoice;
    ViewData["Title"] = $"فاتورة {inv.InvoiceNo}";
    var cur = Model.Currency;
    var canPay = User.Can(Permissions.FinancePayments) && inv.Status != InvoiceStatus.Cancelled;
}

<div class="page-head">
    <div>
        <nav class="breadcrumb">
            <span class="breadcrumb-item"><a asp-action="Invoices">الفواتير</a></span>
            <span class="breadcrumb-item active">@inv.InvoiceNo</span>
        </nav>
        <h1>فاتورة رقم <span class="num">@inv.InvoiceNo</span></h1>
        <p class="sub">
            <a asp-controller="Students" asp-action="Details" asp-route-id="@inv.StudentId">@Model.StudentName</a>
            · @Model.StudentNo · @(Model.Section ?? "—") · @inv.Status.Badge()
        </p>
    </div>
    <div class="actions d-flex gap-2 flex-wrap">
        @if (canPay)
        {
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#payModal">
                <i class="bi bi-cash-coin me-1"></i> تسجيل دفعة
            </button>
        }
        @if (User.Can(Permissions.FinanceDiscounts))
        {
            <button class="btn btn-light" data-bs-toggle="modal" data-bs-target="#discountModal">
                <i class="bi bi-percent me-1"></i> إضافة خصم
            </button>
        }
        <button class="btn btn-light" onclick="window.print()"><i class="bi bi-printer me-1"></i> طباعة</button>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3">
        <div class="stat-card"><div class="ico tone-brand"><i class="bi bi-receipt"></i></div>
            <div><div class="value num">@inv.TotalAmount.ToString("N2")</div><div class="label">إجمالي البنود (@cur)</div></div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card"><div class="ico tone-purple"><i class="bi bi-percent"></i></div>
            <div><div class="value num">@inv.DiscountAmount.ToString("N2")</div><div class="label">الخصومات</div></div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card"><div class="ico tone-ok"><i class="bi bi-cash"></i></div>
            <div><div class="value num">@inv.PaidAmount.ToString("N2")</div><div class="label">المدفوع</div></div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card"><div class="ico @(inv.RemainingAmount > 0 ? "tone-warn" : "tone-ok")"><i class="bi bi-hourglass-split"></i></div>
            <div><div class="value num">@inv.RemainingAmount.ToString("N2")</div><div class="label">المتبقي</div></div></div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        @* ---------- البنود ---------- *@
        <div class="card mb-3">
            <div class="card-header">
                <h2>بنود الفاتورة</h2>
                @if (User.Can(Permissions.FinanceInvoices) && inv.Status != InvoiceStatus.Cancelled)
                {
                    <button class="btn btn-sm btn-light" data-bs-toggle="modal" data-bs-target="#lineModal">
                        <i class="bi bi-plus-lg me-1"></i> إضافة بند
                    </button>
                }
            </div>
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead><tr><th>البيان</th><th class="text-start" style="width:130px">المبلغ</th><th style="width:50px"></th></tr></thead>
                    <tbody>
                    @foreach (var l in inv.Lines)
                    {
                        <tr>
                            <td class="fw-semibold">@l.Description</td>
                            <td class="num">@l.Amount.ToString("N2")</td>
                            <td>
                                @if (User.Can(Permissions.FinanceInvoices) && inv.Status != InvoiceStatus.Cancelled)
                                {
                                    <form asp-action="DeleteInvoiceLine" method="post">
                                        <input type="hidden" name="id" value="@l.Id" />
                                        <button class="btn btn-sm btn-light text-danger" data-confirm="حذف هذا البند؟" aria-label="حذف"><i class="bi bi-x"></i></button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    @foreach (var d in inv.Discounts)
                    {
                        <tr style="background:var(--ok-100)33">
                            <td>
                                <span class="fw-semibold text-success">@d.Name</span>
                                <span class="chip tone-ok">
                                    @(d.DiscountType == DiscountType.Percentage ? $"{d.Value:0.##}%" : d.Value.ToString("N2"))
                                </span>
                                @if (!string.IsNullOrEmpty(d.Reason))
                                {
                                    <div class="fs-xs text-muted-3">@d.Reason</div>
                                }
                            </td>
                            <td class="num text-success">- @d.ComputedAmount.ToString("N2")</td>
                            <td>
                                @if (User.Can(Permissions.FinanceDiscounts))
                                {
                                    <form asp-action="DeleteDiscount" method="post">
                                        <input type="hidden" name="id" value="@d.Id" />
                                        <button class="btn btn-sm btn-light text-danger" data-confirm="إلغاء هذا الخصم؟" aria-label="حذف"><i class="bi bi-x"></i></button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                    <tfoot>
                    <tr style="background:var(--surface-2)">
                        <th>الصافي المستحق</th>
                        <th class="num">@inv.NetAmount.ToString("N2") @cur</th>
                        <th></th>
                    </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        @* ---------- الأقساط ---------- *@
        <div class="card">
            <div class="card-header"><h2>جدول الأقساط</h2></div>
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead><tr><th>القسط</th><th>الاستحقاق</th><th>المبلغ</th><th>المدفوع</th><th>المتبقي</th><th>الحالة</th></tr></thead>
                    <tbody>
                    @foreach (var i in inv.Installments.OrderBy(x => x.SeqNo))
                    {
                        <tr>
                            <td class="fw-semibold">@i.Name</td>
                            <td class="num">
                                @ViewHelpers.Date(i.DueDate)
                                @if (i.IsOverdue)
                                {
                                    <div class="fs-xs text-danger">متأخر @((DateTime.Today - i.DueDate.Date).Days) يوم</div>
                                }
                            </td>
                            <td class="num">@i.Amount.ToString("N2")</td>
                            <td class="num text-success">@i.PaidAmount.ToString("N2")</td>
                            <td class="num @(i.RemainingAmount > 0 ? "fw-bold text-warning" : "")">@i.RemainingAmount.ToString("N2")</td>
                            <td>@i.Status.Badge()</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        @* ---------- بيانات ---------- *@
        <div class="card mb-3">
            <div class="card-header"><h2>بيانات الفاتورة</h2></div>
            <div class="card-body">
                <partial name="_InfoRow" model="@(("رقم الفاتورة", inv.InvoiceNo))" />
                <partial name="_InfoRow" model="@(("تاريخ الإصدار", ViewHelpers.Date(inv.IssueDate)))" />
                <partial name="_InfoRow" model="@(("الطالب", Model.StudentName))" />
                <partial name="_InfoRow" model="@(("الرقم الطلابي", Model.StudentNo))" />
                <partial name="_InfoRow" model="@(("الشعبة", Model.Section ?? "—"))" />
                <partial name="_InfoRow" model="@(("ولي الأمر", Model.GuardianName ?? "—"))" />
                <partial name="_InfoRow" model="@(("جوال ولي الأمر", Model.GuardianPhone ?? "—"))" />
            </div>
        </div>

        @* ---------- المدفوعات ---------- *@
        <div class="card">
            <div class="card-header">
                <h2>سندات القبض</h2>
                <span class="chip tone-brand">@Model.Payments.Count(p => !p.IsCancelled)</span>
            </div>
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead><tr><th>الإيصال</th><th>المبلغ</th><th>التاريخ</th><th>الطريقة</th><th></th></tr></thead>
                    <tbody>
                    @if (Model.Payments.Count == 0)
                    {
                        <tr><td colspan="5"><div class="empty-state"><i class="bi bi-cash"></i>لا توجد مدفوعات</div></td></tr>
                    }
                    @foreach (var p in Model.Payments)
                    {
                        <tr class="@(p.IsCancelled ? "text-decoration-line-through text-muted-3" : "")">
                            <td><a asp-action="Receipt" asp-route-id="@p.Id" class="num fs-xs">@p.ReceiptNo</a></td>
                            <td class="num fw-bold">@p.Amount.ToString("N2")</td>
                            <td class="num fs-xs">@ViewHelpers.Date(p.PaymentDate)</td>
                            <td class="fs-xs">@p.Method.Display()</td>
                            <td>
                                @if (!p.IsCancelled && User.Can(Permissions.FinanceCancelPayment))
                                {
                                    <button class="btn btn-sm btn-light text-danger"
                                            onclick="cancelPayment(@p.Id, '@p.ReceiptNo')" title="إلغاء السند">
                                        <i class="bi bi-x-circle"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@* ==================== النوافذ ==================== *@
@if (canPay)
{
    <div class="modal fade" id="payModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content" asp-action="AddPayment" method="post">
                <input type="hidden" name="InvoiceId" value="@inv.Id" />
                <div class="modal-header">
                    <h5 class="modal-title">تسجيل دفعة</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info fs-sm">
                        المتبقي على الفاتورة: <b class="num">@inv.RemainingAmount.ToString("N2") @cur</b>
                    </div>
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label">المبلغ</label>
                            <input name="Amount" type="number" step="0.01" min="0.01" max="@inv.RemainingAmount"
                                   value="@inv.Installments.OrderBy(x => x.DueDate).FirstOrDefault(x => x.RemainingAmount > 0)?.RemainingAmount.ToString("0.00")"
                                   class="form-control num" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label">تاريخ الدفع</label>
                            <input name="PaymentDate" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">طريقة الدفع</label>
                            <select name="Method" class="form-select">
                                @foreach (var (v, t) in ViewHelpers.Options<PaymentMethod>())
                                {
                                    <option value="@((int)v)">@t</option>
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label">خصم من القسط</label>
                            <select name="InstallmentId" class="form-select">
                                <option value="">تلقائي (الأقدم استحقاقاً)</option>
                                @foreach (var i in inv.Installments.Where(x => x.RemainingAmount > 0).OrderBy(x => x.SeqNo))
                                {
                                    <option value="@i.Id">@i.Name — متبقي @i.RemainingAmount.ToString("N2")</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">المرجع / رقم الشيك</label>
                            <input name="Reference" class="form-control" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">ملاحظات</label>
                            <textarea name="Notes" class="form-control" rows="2"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary"><i class="bi bi-check-lg me-1"></i> تسجيل الدفعة</button>
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">إلغاء</button>
                </div>
            </form>
        </div>
    </div>
}

@if (User.Can(Permissions.FinanceDiscounts))
{
    <div class="modal fade" id="discountModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content" asp-action="AddDiscount" method="post">
                <input type="hidden" name="invoiceId" value="@inv.Id" />
                <div class="modal-header">
                    <h5 class="modal-title">إضافة خصم</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">اسم الخصم</label>
                        <input name="name" class="form-control" placeholder="خصم الأخوة / خصم التفوق" required />
                    </div>
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label">نوع الخصم</label>
                            <select name="discountType" class="form-select">
                                @foreach (var (v, t) in ViewHelpers.Options<DiscountType>())
                                {
                                    <option value="@((int)v)">@t</option>
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label">القيمة</label>
                            <input name="value" type="number" step="0.01" min="0.01" class="form-control num" required />
                        </div>
                    </div>
                    <div class="mt-3">
                        <label class="form-label">السبب</label>
                        <textarea name="reason" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary">تطبيق الخصم</button>
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">إلغاء</button>
                </div>
            </form>
        </div>
    </div>
}

@if (User.Can(Permissions.FinanceCancelPayment))
{
    <div class="modal fade" id="cancelModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content" asp-action="CancelPayment" method="post">
                <input type="hidden" name="id" id="cancelId" />
                <div class="modal-header">
                    <h5 class="modal-title">إلغاء سند قبض</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning fs-sm">
                        سيتم إلغاء السند <b id="cancelReceipt" class="num"></b> وإعادة احتساب الفاتورة والأقساط.
                    </div>
                    <label class="form-label">سبب الإلغاء</label>
                    <textarea name="reason" class="form-control" rows="3" required></textarea>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-danger">تأكيد الإلغاء</button>
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">تراجع</button>
                </div>
            </form>
        </div>
    </div>
}

@if (User.Can(Permissions.FinanceInvoices) && inv.Status != InvoiceStatus.Cancelled)
{
    <div class="modal fade" id="lineModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content" asp-action="AddInvoiceLine" method="post">
                <input type="hidden" name="invoiceId" value="@inv.Id" />
                <div class="modal-header">
                    <h5 class="modal-title">إضافة بند للفاتورة</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">بند رسوم معرّف</label>
                        <select name="feeItemId" id="feeSelect" class="form-select" asp-items="Model.FeeItems">
                            <option value="">— بند مخصص —</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">البيان</label>
                        <input name="description" id="lineDesc" class="form-control" />
                    </div>
                    <div>
                        <label class="form-label">المبلغ</label>
                        <input name="amount" id="lineAmount" type="number" step="0.01" min="0" class="form-control num" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary">إضافة</button>
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">إلغاء</button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <script>
        function cancelPayment(id, receipt) {
            document.getElementById('cancelId').value = id;
            document.getElementById('cancelReceipt').textContent = receipt;
            new bootstrap.Modal(document.getElementById('cancelModal')).show();
        }

        document.getElementById('feeSelect')?.addEventListener('change', function () {
            const text = this.options[this.selectedIndex].text;
            if (!this.value) { document.getElementById('lineDesc').value = ''; return; }
            const m = text.match(/^(.*)\s\(([\d.,]+)\)$/);
            if (m) {
                document.getElementById('lineDesc').value = m[1].trim();
                document.getElementById('lineAmount').value = m[2].replace(/,/g, '');
            }
        });
    </script>
}
