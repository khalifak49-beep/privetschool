@model PaymentIndexViewModel
@{
    ViewData["Title"] = "المدفوعات";
    var cur = Model.Currency;
}

<div class="page-head">
    <div>
        <h1>سندات القبض</h1>
        <p class="sub">
            @Model.TotalCount.ToString("N0") سند ·
            الإجمالي <b class="num text-success">@Model.TotalAmount.ToString("N2")</b> @cur
        </p>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-lg-3 col-md-6">
                <label class="form-label">بحث</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input name="q" value="@Model.Q" class="form-control" placeholder="رقم الإيصال، الطالب..." />
                </div>
            </div>
            <div class="col-lg-2 col-md-6">
                <label class="form-label">من تاريخ</label>
                <input name="from" type="date" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-lg-2 col-md-6">
                <label class="form-label">إلى تاريخ</label>
                <input name="to" type="date" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-lg-2 col-md-6">
                <label class="form-label">طريقة الدفع</label>
                <select name="method" class="form-select form-select-sm" data-autosubmit>
                    <option value="">الكل</option>
                    @foreach (var (v, t) in ViewHelpers.Options<PaymentMethod>())
                    {
                        <option value="@((int)v)" selected="@(Model.Method == v)">@t</option>
                    }
                </select>
            </div>
            <div class="col-lg-2 col-md-6">
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" name="includeCancelled" value="true"
                           id="incCancel" checked="@Model.IncludeCancelled" />
                    <label class="form-check-label fs-sm" for="incCancel">إظهار الملغاة</label>
                </div>
            </div>
            <div class="col-lg-1 col-md-6 d-flex gap-1">
                <button class="btn btn-sm btn-primary flex-grow-1" aria-label="تطبيق التصفية"><i class="bi bi-funnel"></i></button>
                <a asp-action="Payments" class="btn btn-sm btn-light" aria-label="مسح الفلاتر"><i class="bi bi-x-lg"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="table-wrap">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
            <tr>
                <th>رقم الإيصال</th>
                <th>الطالب</th>
                <th>الفاتورة</th>
                <th>المبلغ</th>
                <th>التاريخ</th>
                <th>الطريقة</th>
                <th>المرجع</th>
                <th style="width:60px"></th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Payments.TotalCount == 0)
            {
                <tr><td colspan="8"><div class="empty-state"><i class="bi bi-cash-stack"></i>لا توجد مدفوعات</div></td></tr>
            }
            @foreach (var p in Model.Payments.Items)
            {
                <tr class="@(p.IsCancelled ? "opacity-50" : "")">
                    <td>
                        <a asp-action="Receipt" asp-route-id="@p.Id" class="num fw-semibold text-reset">@p.ReceiptNo</a>
                        @if (p.IsCancelled)
                        {
                            <span class="chip tone-danger">ملغى</span>
                        }
                    </td>
                    <td>
                        <a asp-controller="Students" asp-action="Details" asp-route-id="@p.StudentId" class="fw-semibold text-reset">@p.StudentName</a>
                        <div class="fs-xs text-muted-3 num">@p.StudentNo</div>
                    </td>
                    <td><a asp-action="InvoiceDetails" asp-route-id="@p.InvoiceId" class="num fs-sm">@p.InvoiceNo</a></td>
                    <td class="num fw-bold @(p.IsCancelled ? "text-decoration-line-through" : "text-success")">@p.Amount.ToString("N2")</td>
                    <td class="num fs-sm">@ViewHelpers.Date(p.PaymentDate)</td>
                    <td><span class="chip tone-brand">@p.Method.Display()</span></td>
                    <td class="fs-sm text-muted-2">@(p.Reference ?? "—")</td>
                    <td>
                        <a class="btn btn-sm btn-light" asp-action="Receipt" asp-route-id="@p.Id" title="الإيصال">
                            <i class="bi bi-printer"></i>
                        </a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="Model.Payments" />
</div>
