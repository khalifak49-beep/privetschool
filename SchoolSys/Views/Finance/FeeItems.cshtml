@model FeeItemsViewModel
@{
    ViewData["Title"] = "بنود الرسوم";
    var cur = Model.Currency;
}

<div class="page-head">
    <div>
        <h1>بنود الرسوم الدراسية</h1>
        <p class="sub">
            إجمالي البنود الإجبارية: <b class="num">@Model.TotalMandatory.ToString("N2")</b> @cur لكل طالب
        </p>
    </div>
    <div class="actions">
        <button class="btn btn-primary" onclick="openFee()"><i class="bi bi-plus-lg me-1"></i> بند جديد</button>
    </div>
</div>

<div class="table-wrap">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
            <tr>
                <th>البند</th>
                <th>المبلغ (@cur)</th>
                <th>يُطبَّق على</th>
                <th>النوع</th>
                <th>الحالة</th>
                <th style="width:100px"></th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="6"><div class="empty-state"><i class="bi bi-list-check"></i>لم يتم تعريف بنود رسوم بعد</div></td></tr>
            }
            @foreach (var f in Model.Items)
            {
                <tr>
                    <td>
                        <div class="fw-semibold">@f.Name</div>
                        @if (!string.IsNullOrEmpty(f.Description))
                        {
                            <div class="fs-xs text-muted-3">@f.Description</div>
                        }
                    </td>
                    <td class="num fw-bold">@f.DefaultAmount.ToString("N2")</td>
                    <td class="fs-sm text-muted-2">@(f.Grade?.Name ?? "جميع الصفوف")</td>
                    <td>
                        @if (f.IsMandatory)
                        {
                            <span class="chip tone-brand">إجباري</span>
                        }
                        else
                        {
                            <span class="chip tone-info">اختياري</span>
                        }
                    </td>
                    <td>
                        @if (f.IsActive)
                        {
                            <span class="chip tone-ok">نشط</span>
                        }
                        else
                        {
                            <span class="chip tone-danger">معطّل</span>
                        }
                    </td>
                    <td>
                        <div class="d-flex gap-1">
                            <button class="btn btn-sm btn-light"
                                    onclick='openFee(@Html.Raw(Json.Serialize(new { f.Id, f.Name, f.Description, f.DefaultAmount, f.GradeId, f.IsMandatory, f.IsActive, f.AcademicYearId })))' aria-label="تعديل">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <form asp-action="DeleteFeeItem" method="post">
                                <input type="hidden" name="id" value="@f.Id" />
                                <button class="btn btn-sm btn-light text-danger" data-confirm="حذف هذا البند؟" aria-label="حذف"><i class="bi bi-trash"></i></button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="feeModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" asp-action="SaveFeeItem" method="post">
            <input type="hidden" name="Id" id="f-id" value="0" />
            <input type="hidden" name="AcademicYearId" id="f-year" value="@Model.CurrentYearId" />
            <div class="modal-header">
                <h5 class="modal-title">بند رسوم</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">اسم البند</label>
                    <input name="Name" id="f-name" class="form-control" placeholder="الرسوم الدراسية" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">الوصف</label>
                    <input name="Description" id="f-desc" class="form-control" />
                </div>
                <div class="row g-2">
                    <div class="col-6">
                        <label class="form-label">المبلغ (@cur)</label>
                        <input name="DefaultAmount" id="f-amount" type="number" step="0.01" min="0" class="form-control num" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label">الصف (اختياري)</label>
                        <select name="GradeId" id="f-grade" class="form-select" asp-items="Model.Grades">
                            <option value="">جميع الصفوف</option>
                        </select>
                    </div>
                </div>
                <div class="d-flex gap-4 mt-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="IsMandatory" value="true" id="f-mand" checked />
                        <label class="form-check-label" for="f-mand">بند إجباري</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="f-active" checked />
                        <label class="form-check-label" for="f-active">نشط</label>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-primary">حفظ</button>
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">إلغاء</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openFee(d) {
            d = d || { Id: 0, Name: '', Description: '', DefaultAmount: '', GradeId: '', IsMandatory: true, IsActive: true, AcademicYearId: @(Model.CurrentYearId ?? 0) };
            document.getElementById('f-id').value = d.Id;
            document.getElementById('f-name').value = d.Name || '';
            document.getElementById('f-desc').value = d.Description || '';
            document.getElementById('f-amount').value = d.DefaultAmount || '';
            document.getElementById('f-grade').value = d.GradeId || '';
            document.getElementById('f-year').value = d.AcademicYearId || @(Model.CurrentYearId ?? 0);
            document.getElementById('f-mand').checked = !!d.IsMandatory;
            document.getElementById('f-active').checked = !!d.IsActive;
            new bootstrap.Modal(document.getElementById('feeModal')).show();
        }
    </script>
}
