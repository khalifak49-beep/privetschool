@model ExamFormViewModel
@{
    ViewData["Title"] = Model.IsEdit ? "تعديل اختبار" : "اختبار جديد";
}

<div class="page-head">
    <div>
        <nav class="breadcrumb">
            <span class="breadcrumb-item"><a asp-action="Index">الاختبارات</a></span>
            <span class="breadcrumb-item active">@ViewData["Title"]</span>
        </nav>
        <h1>@ViewData["Title"]</h1>
    </div>
</div>

<div class="row">
    <div class="col-lg-9">
        <div class="card">
            <form asp-action="@(Model.IsEdit ? "Edit" : "Create")" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger fs-sm"></div>

                    <div class="row g-3">
                        <div class="col-md-8">
                            <label asp-for="Title" class="form-label"></label>
                            <input asp-for="Title" class="form-control" placeholder="اختبار الفترة الأولى" />
                            <span asp-validation-for="Title" class="text-danger fs-xs"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ExamType" class="form-label"></label>
                            <select asp-for="ExamType" class="form-select">
                                @foreach (var (v, t) in ViewHelpers.Options<ExamType>())
                                {
                                    <option value="@((int)v)" selected="@(Model.ExamType == v)">@t</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="SectionId" class="form-label"></label>
                            <select asp-for="SectionId" class="form-select" asp-items="Model.Sections" disabled="@Model.IsEdit">
                                <option value="">— اختر الشعبة —</option>
                            </select>
                            @if (Model.IsEdit)
                            {
                                <input type="hidden" asp-for="SectionId" />
                                <div class="form-text fs-xs">لا يمكن تغيير الشعبة بعد إنشاء الاختبار.</div>
                            }
                            <span asp-validation-for="SectionId" class="text-danger fs-xs"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="SubjectId" class="form-label"></label>
                            <select asp-for="SubjectId" class="form-select" asp-items="Model.Subjects">
                                <option value="">— اختر المادة —</option>
                            </select>
                            <span asp-validation-for="SubjectId" class="text-danger fs-xs"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="TermId" class="form-label"></label>
                            <select asp-for="TermId" class="form-select" asp-items="Model.Terms">
                                <option value="">— اختر الفصل —</option>
                            </select>
                            <span asp-validation-for="TermId" class="text-danger fs-xs"></span>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="ExamDate" class="form-label"></label>
                            <input asp-for="ExamDate" type="date" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="StartTime" class="form-label"></label>
                            <input asp-for="StartTime" type="time" class="form-control num" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="DurationMinutes" class="form-label"></label>
                            <input asp-for="DurationMinutes" type="number" class="form-control num" />
                            <span asp-validation-for="DurationMinutes" class="text-danger fs-xs"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Status" class="form-label"></label>
                            <select asp-for="Status" class="form-select">
                                @foreach (var (v, t) in ViewHelpers.Options<ExamStatus>())
                                {
                                    @if (v != ExamStatus.Approved || User.Can(Permissions.ExamsApprove))
                                    {
                                        <option value="@((int)v)" selected="@(Model.Status == v)">@t</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="MaxScore" class="form-label"></label>
                            <input asp-for="MaxScore" type="number" step="0.01" class="form-control num" />
                            <span asp-validation-for="MaxScore" class="text-danger fs-xs"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="PassScore" class="form-label"></label>
                            <input asp-for="PassScore" type="number" step="0.01" class="form-control num" />
                            <span asp-validation-for="PassScore" class="text-danger fs-xs"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Weight" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="Weight" type="number" step="0.01" class="form-control num" />
                                <span class="input-group-text">%</span>
                            </div>
                        </div>

                        <div class="col-12">
                            <label asp-for="Notes" class="form-label"></label>
                            <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex gap-2">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i> حفظ</button>
                    <a class="btn btn-light" asp-action="Index">إلغاء</a>
                </div>
            </form>
        </div>
    </div>

    <div class="col-lg-3">
        <div class="card">
            <div class="card-body">
                <div class="fw-bold fs-sm mb-2"><i class="bi bi-info-circle me-1"></i> ملاحظات</div>
                <ul class="fs-xs text-muted-2 ps-3 mb-0 lh-lg">
                    <li>عند إنشاء الاختبار تُنشأ سجلات درجات فارغة لكل طلاب الشعبة تلقائياً.</li>
                    <li>حالة «معلن» ترسل إشعاراً للطلاب بموعد الاختبار.</li>
                    <li>حالة «معتمد» تقفل الدرجات وترسل النتائج لأولياء الأمور.</li>
                    <li>الوزن يُستخدم في احتساب مجموع الفصل الدراسي.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}
