@model EmployeeIndexViewModel
@{
    ViewData["Title"] = "الموظفون والمعلمون";
}

<div class="page-head">
    <div>
        <h1>الموظفون والمعلمون</h1>
        <p class="sub">
            @Model.TotalCount.ToString("N0") موظف · @Model.TeachersCount.ToString("N0") معلم ·
            @Model.ActiveCount.ToString("N0") على رأس العمل
        </p>
    </div>
    <div class="actions d-flex gap-2 flex-wrap">
        @if (User.Can(Permissions.EmployeesCreate))
        {
            <a class="btn btn-primary" asp-action="Create"><i class="bi bi-person-plus me-1"></i> إضافة موظف</a>
        }
        @if (User.Can(Permissions.ReportsExport))
        {
            <a class="btn btn-light" asp-action="Export" asp-route-q="@Model.Q" asp-route-type="@Model.Type" asp-route-format="excel">
                <i class="bi bi-file-earmark-excel me-1"></i> تصدير
            </a>
        }
    </div>
</div>

<div class="card mb-3">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label">بحث</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input name="q" value="@Model.Q" class="form-control" placeholder="الاسم، الرقم الوظيفي، التخصص..." />
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label">الوظيفة</label>
                <select name="type" class="form-select form-select-sm" data-autosubmit>
                    <option value="">الكل</option>
                    @foreach (var (v, t) in ViewHelpers.Options<EmployeeType>())
                    {
                        <option value="@((int)v)" selected="@(Model.Type == v)">@t</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">الحالة</label>
                <select name="isActive" class="form-select form-select-sm" data-autosubmit>
                    <option value="">الكل</option>
                    <option value="true" selected="@(Model.IsActive == true)">نشط</option>
                    <option value="false" selected="@(Model.IsActive == false)">معطّل</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-1">
                <button class="btn btn-sm btn-primary flex-grow-1"><i class="bi bi-funnel me-1"></i> بحث</button>
                <a asp-action="Index" class="btn btn-sm btn-light">مسح</a>
            </div>
        </form>
    </div>
</div>

<div class="table-wrap">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
            <tr>
                <th style="width:100px">الرقم</th>
                <th>الموظف</th>
                <th>الوظيفة</th>
                <th>التخصص</th>
                <th>الجوال</th>
                <th>الشعب</th>
                <th>الحالة</th>
                <th style="width:100px"></th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Employees.TotalCount == 0)
            {
                <tr><td colspan="8"><div class="empty-state"><i class="bi bi-person-badge"></i>لا توجد نتائج</div></td></tr>
            }
            @foreach (var e in Model.Employees.Items)
            {
                <tr>
                    <td class="num fs-sm text-muted-2">@e.EmployeeNo</td>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <div class="avatar sm">
                                @if (!string.IsNullOrEmpty(e.PhotoPath))
                                {
                                    <img src="@e.PhotoPath" alt="" />
                                }
                                else
                                {
                                    @ViewHelpers.Initials(e.FullName)
                                }
                            </div>
                            <div class="min-w-0">
                                <a asp-action="Details" asp-route-id="@e.Id" class="fw-semibold text-reset d-block text-truncate">@e.FullName</a>
                                @if (e.HasAccount)
                                {
                                    <div class="fs-xs text-success"><i class="bi bi-check-circle"></i> لديه حساب</div>
                                }
                            </div>
                        </div>
                    </td>
                    <td>@e.EmployeeType.Badge()</td>
                    <td class="fs-sm text-muted-2">@(e.Specialization ?? "—")</td>
                    <td class="num fs-sm" dir="ltr">@(e.Phone ?? "—")</td>
                    <td>
                        @if (e.SectionsCount > 0)
                        {
                            <span class="chip tone-brand num">@e.SectionsCount</span>
                        }
                        else
                        {
                            <span class="text-muted-3">—</span>
                        }
                    </td>
                    <td>
                        @if (e.IsActive)
                        {
                            <span class="chip tone-ok">نشط</span>
                        }
                        else
                        {
                            <span class="chip tone-danger">معطّل</span>
                        }
                    </td>
                    <td>
                        <div class="d-flex gap-1">
                            <a class="btn btn-sm btn-light" asp-action="Details" asp-route-id="@e.Id" aria-label="عرض التفاصيل"><i class="bi bi-eye"></i></a>
                            @if (User.Can(Permissions.EmployeesEdit))
                            {
                                <a class="btn btn-sm btn-light" asp-action="Edit" asp-route-id="@e.Id" aria-label="تعديل"><i class="bi bi-pencil"></i></a>
                            }
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="Model.Employees" />
</div>
