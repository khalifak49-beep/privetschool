@model GuardianDetailsViewModel
@{
    var g = Model.Guardian;
    ViewData["Title"] = g.FullName;
    var cur = Model.Currency;
}

<div class="page-head">
    <div>
        <nav class="breadcrumb">
            <span class="breadcrumb-item"><a asp-action="Index">أولياء الأمور</a></span>
            <span class="breadcrumb-item active">@g.FullName</span>
        </nav>
        <h1>@g.FullName</h1>
        <p class="sub">@g.Phone · @Model.Children.Count من الأبناء</p>
    </div>
    <div class="actions d-flex gap-2 flex-wrap">
        @if (User.Can(Permissions.GuardiansEdit))
        {
            <a class="btn btn-primary" asp-action="Edit" asp-route-id="@g.Id"><i class="bi bi-pencil me-1"></i> تعديل</a>
        }
        @if (!Model.HasAccount && User.Can(Permissions.UsersManage))
        {
            <a class="btn btn-light" asp-action="CreateAccount" asp-route-id="@g.Id">
                <i class="bi bi-person-plus me-1"></i> إنشاء حساب دخول
            </a>
        }
        @if (User.Can(Permissions.GuardiansDelete))
        {
            <form asp-action="Delete" asp-route-id="@g.Id" method="post" class="d-inline">
                <button class="btn btn-light text-danger" data-confirm="سيتم حذف ولي الأمر وإلغاء ربطه بالأبناء. متابعة؟">
                    <i class="bi bi-trash"></i>
                </button>
            </form>
        }
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header"><h2>بيانات ولي الأمر</h2></div>
            <div class="card-body">
                <partial name="_InfoRow" model="@(("الاسم", g.FullName))" />
                <partial name="_InfoRow" model="@(("رقم الهوية", g.NationalId ?? "—"))" />
                <partial name="_InfoRow" model="@(("الجوال", g.Phone))" />
                <partial name="_InfoRow" model="@(("هاتف بديل", g.AltPhone ?? "—"))" />
                <partial name="_InfoRow" model="@(("البريد الإلكتروني", g.Email ?? "—"))" />
                <partial name="_InfoRow" model="@(("المهنة", g.Job ?? "—"))" />
                <partial name="_InfoRow" model="@(("جهة العمل", g.Workplace ?? "—"))" />
                <partial name="_InfoRow" model="@(("العنوان", g.Address ?? "—"))" />
                <partial name="_InfoRow" model="@(("حساب الدخول", Model.AccountEmail ?? "غير منشأ"))" />
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card">
            <div class="card-header"><h2>الأبناء المرتبطون</h2></div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                    <tr><th>الطالب</th><th>الشعبة</th><th>صلة القرابة</th><th>الحضور</th><th>المتبقي</th><th></th></tr>
                    </thead>
                    <tbody>
                    @if (Model.Children.Count == 0)
                    {
                        <tr><td colspan="6"><div class="empty-state"><i class="bi bi-mortarboard"></i>لا يوجد أبناء مرتبطون</div></td></tr>
                    }
                    @foreach (var c in Model.Children)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="avatar sm">
                                        @if (!string.IsNullOrEmpty(c.PhotoPath))
                                        {
                                            <img src="@c.PhotoPath" alt="" />
                                        }
                                        else
                                        {
                                            @ViewHelpers.Initials(c.FullName)
                                        }
                                    </div>
                                    <div>
                                        <a asp-controller="Students" asp-action="Details" asp-route-id="@c.StudentId" class="fw-semibold text-reset">@c.FullName</a>
                                        <div class="fs-xs text-muted-3 num">@c.StudentNo</div>
                                    </div>
                                </div>
                            </td>
                            <td class="fs-sm">@(c.Section ?? "—")</td>
                            <td>
                                @c.Relation
                                @if (c.IsPrimary)
                                {
                                    <span class="chip tone-ok">أساسي</span>
                                }
                            </td>
                            <td>
                                <span class="num fw-semibold @(c.AttendanceRate >= 90 ? "text-success" : c.AttendanceRate >= 75 ? "text-warning" : "text-danger")">
                                    @c.AttendanceRate.ToString("0.#")%
                                </span>
                            </td>
                            <td>
                                @if (c.Outstanding > 0)
                                {
                                    <span class="chip tone-warn num">@c.Outstanding.ToString("N2") @cur</span>
                                }
                                else
                                {
                                    <span class="chip tone-ok">مسدد</span>
                                }
                            </td>
                            <td>
                                <a class="btn btn-sm btn-light" asp-controller="Students" asp-action="Details" asp-route-id="@c.StudentId" aria-label="عرض التفاصيل">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
