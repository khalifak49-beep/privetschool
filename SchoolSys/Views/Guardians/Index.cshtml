@model GuardianIndexViewModel
@{
    ViewData["Title"] = "أولياء الأمور";
}

<div class="page-head">
    <div>
        <h1>أولياء الأمور</h1>
        <p class="sub">@Model.TotalGuardians.ToString("N0") ولي أمر · @Model.WithAccounts.ToString("N0") لديهم حسابات دخول</p>
    </div>
    <div class="actions d-flex gap-2 flex-wrap">
        @if (User.Can(Permissions.GuardiansCreate))
        {
            <a class="btn btn-primary" asp-action="Create"><i class="bi bi-person-plus me-1"></i> إضافة ولي أمر</a>
        }
        @if (User.Can(Permissions.ReportsExport))
        {
            <a class="btn btn-light" asp-action="Export" asp-route-q="@Model.Q" asp-route-format="excel">
                <i class="bi bi-file-earmark-excel me-1"></i> تصدير
            </a>
        }
    </div>
</div>

<div class="card mb-3">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label">بحث</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input name="q" value="@Model.Q" class="form-control" placeholder="الاسم، الجوال، الهوية، البريد..." />
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label">حساب الدخول</label>
                <select name="hasAccount" class="form-select form-select-sm" data-autosubmit>
                    <option value="">الكل</option>
                    <option value="true" selected="@(Model.HasAccount == true)">لديه حساب</option>
                    <option value="false" selected="@(Model.HasAccount == false)">بدون حساب</option>
                </select>
            </div>
            <div class="col-md-4 d-flex gap-1">
                <button class="btn btn-sm btn-primary"><i class="bi bi-funnel me-1"></i> بحث</button>
                <a asp-action="Index" class="btn btn-sm btn-light">مسح</a>
            </div>
        </form>
    </div>
</div>

<div class="table-wrap">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
            <tr>
                <th>ولي الأمر</th>
                <th>الجوال</th>
                <th>الأبناء</th>
                <th>المهنة</th>
                <th>المديونية</th>
                <th>الحساب</th>
                <th style="width:100px"></th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Guardians.TotalCount == 0)
            {
                <tr><td colspan="7"><div class="empty-state"><i class="bi bi-people"></i>لا توجد نتائج</div></td></tr>
            }
            @foreach (var g in Model.Guardians.Items)
            {
                <tr>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <div class="avatar sm">@ViewHelpers.Initials(g.FullName)</div>
                            <div class="min-w-0">
                                <a asp-action="Details" asp-route-id="@g.Id" class="fw-semibold text-reset d-block text-truncate">@g.FullName</a>
                                @if (!string.IsNullOrEmpty(g.Email))
                                {
                                    <div class="fs-xs text-muted-3" dir="ltr">@g.Email</div>
                                }
                            </div>
                        </div>
                    </td>
                    <td class="num fs-sm" dir="ltr">@g.Phone</td>
                    <td>
                        <span class="chip tone-brand num">@g.ChildrenCount</span>
                        <div class="fs-xs text-muted-3 text-truncate" style="max-width:230px">@g.Children</div>
                    </td>
                    <td class="fs-sm text-muted-2">@(g.Job ?? "—")</td>
                    <td>
                        @if (g.Outstanding > 0)
                        {
                            <span class="chip tone-warn num">@g.Outstanding.ToString("N2")</span>
                        }
                        else
                        {
                            <span class="chip tone-ok">مسدد</span>
                        }
                    </td>
                    <td>
                        @if (g.HasAccount)
                        {
                            <span class="chip tone-ok"><i class="bi bi-check2"></i>مفعّل</span>
                        }
                        else
                        {
                            <span class="chip tone-warn">بدون</span>
                        }
                    </td>
                    <td>
                        <div class="d-flex gap-1">
                            <a class="btn btn-sm btn-light" asp-action="Details" asp-route-id="@g.Id"><i class="bi bi-eye"></i></a>
                            @if (User.Can(Permissions.GuardiansEdit))
                            {
                                <a class="btn btn-sm btn-light" asp-action="Edit" asp-route-id="@g.Id"><i class="bi bi-pencil"></i></a>
                            }
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="Model.Guardians" />
</div>
